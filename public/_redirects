# Applied by Cloudflare Workers before the static asset lookup. These carry
# over the 301s that vercel.json declared when donate and careers were folded
# into contact (docs/15-contact-consolidation.md), so no old link 404s.
# Both slash forms are listed because redirects run before the trailing-slash
# normalisation that html_handling applies to real pages.

/donate            /contact/     301
/donate/           /contact/     301
/km/donate         /km/contact/  301
/km/donate/        /km/contact/  301
/careers           /contact/     301
/careers/*         /contact/     301
/km/careers        /km/contact/  301
/km/careers/*      /km/contact/  301

# The partner and volunteer forms were folded into the one contact form; the
# topic parameter opens it on the matching choice.
/partner-with-us      /contact/?topic=partner       301
/partner-with-us/     /contact/?topic=partner       301
/km/partner-with-us   /km/contact/?topic=partner    301
/km/partner-with-us/  /km/contact/?topic=partner    301
/volunteer            /contact/?topic=volunteer     301
/volunteer/           /contact/?topic=volunteer     301
/km/volunteer         /km/contact/?topic=volunteer  301
/km/volunteer/        /km/contact/?topic=volunteer  301

# Crawlers and webmaster tools that are not told otherwise look for the
# sitemap here; the real one is the index @astrojs/sitemap writes.
/sitemap.xml  /sitemap-index.xml  301

