---
import { htmlLang, locales, type Locale } from '~/lib/i18n/config';
import type { SiteSettings } from '~/lib/content/types';
import { getPrograms } from '~/lib/content';
import { localizePath, parsePath, pick, t, text } from '~/lib/i18n/utils';
import { mainNav } from '~/lib/nav';
import { aboutSubpages, availableAboutGroups } from '~/lib/about-groups';
import { impactProjectsAvailable, impactProjectsPath } from '~/lib/impact-pages';
import { donateHref } from '~/lib/skeleton-content';
import LanguageToggle from './LanguageToggle.astro';
import Logo from '~/components/Logo.astro';

interface Props {
  lang: Locale;
  pathname: string;
  settings: SiteSettings;
}

const { lang, pathname, settings } = Astro.props;

const orgName = text(settings.orgName, lang);

const current = parsePath(pathname).path.replace(/\/$/, '') || '/';
const [programs, aboutGroups, hasImpactProjects] = await Promise.all([
  getPrograms(),
  availableAboutGroups(lang),
  impactProjectsAvailable(lang),
]);
const shownAbout = new Set(aboutGroups.map((group) => group.path));
const hiddenPaths = new Set(
  aboutSubpages.map((group) => group.path).filter((path) => !shownAbout.has(path)),
);
if (!hasImpactProjects) hiddenPaths.add(impactProjectsPath);
const dropdownLinks = (item: (typeof mainNav)[number]) => {
  if (item.programs) {
    return programs.flatMap((program) => {
      const label = pick(program.title, lang).value;
      return label ? [{ label, href: localizePath(`/programs/${program.slug}`, lang) }] : [];
    });
  }
  return (item.sections ?? [])
    .filter((section) => !section.path || !hiddenPaths.has(section.path))
    .map((section) => ({
      label: t(lang, section.key),
      href: section.path
        ? localizePath(section.path, lang)
        : current === item.path
          ? `#${section.id}`
          : `${localizePath(item.path, lang)}#${section.id}`,
    }));
};
const isCurrent = (path: string) => current === path || current.startsWith(`${path}/`);
const navGroups = mainNav.map((item) => ({ item, links: dropdownLinks(item) }));
---

<header class="hdr site-header" data-header data-home={current === '/' ? '' : undefined}>
  <script is:inline>
    // Inline so the bar is marked before it first paints.
    try {
      const bar = document.currentScript.parentElement;
      if (bar.hasAttribute('data-home')) {
        if (sessionStorage.getItem('sko-header-intro')) bar.setAttribute('data-skip-intro', '');
        sessionStorage.setItem('sko-header-intro', '1');
      }
    } catch {}
  </script>
  <div class="hdr__bar">
    <a href={localizePath('/', lang)} class="hdr__brand">
      <Logo variant="full" height={74} title={orgName} class="hdr__logo" />
      {
        current === '/' && (
          <Logo
            variant="reversed"
            height={74}
            title={orgName}
            class="hdr__logo hdr__logo--reversed"
          />
        )
      }
    </a>

    <nav class="hdr__nav" aria-label={t(lang, 'navPrimaryLabel')}>
      {
        navGroups.map(({ item, links }, index) => {
          const menuId = `dd-${index}`;
          return (
            <div class="hdr__item" data-nav-item>
              <a
                href={localizePath(item.path, lang)}
                class="hdr__link"
                aria-current={isCurrent(item.path) ? 'page' : undefined}
              >
                <span class="hdr__labels">
                  {locales.map((locale) => (
                    <span
                      class:list={['hdr__label', `hdr__label--${locale}`]}
                      lang={htmlLang[locale]}
                    >
                      {t(locale, item.key)}
                    </span>
                  ))}
                </span>
              </a>
              {links.length > 0 && (
                <>
                  <button
                    type="button"
                    class="hdr__chev"
                    aria-expanded="false"
                    aria-controls={menuId}
                    aria-label={`${t(lang, item.key)}: ${t(lang, 'navShowSections')}`}
                    data-dd-toggle
                  >
                    <svg
                      width="12"
                      height="12"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.4"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d="m6 9 6 6 6-6" />
                    </svg>
                  </button>
                  <div class="dd" id={menuId} data-dd inert>
                    <div class="dd__inner">
                      <ul class="dd__list">
                        {links.map((link, i) => (
                          <li style={`--i:${i}`}>
                            <a href={link.href} class="dd__link">
                              <span>{link.label}</span>
                              <svg
                                width="16"
                                height="16"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                aria-hidden="true"
                              >
                                <path d="m9 6 6 6-6 6" />
                              </svg>
                            </a>
                          </li>
                        ))}
                      </ul>
                    </div>
                  </div>
                </>
              )}
            </div>
          );
        })
      }
    </nav>

    <div class="hdr__tools">
      <span class="hdr__toggle-desktop">
        <LanguageToggle lang={lang} pathname={pathname} />
      </span>
      <span class="hdr__toggle-phone">
        <LanguageToggle lang={lang} pathname={pathname} variant="phone" />
      </span>
      <a href={localizePath('/contact?topic=partner', lang)} class="hdr__pill"
        >{t(lang, 'contactUs')}</a
      >
      <button
        type="button"
        class="hdr__burger"
        aria-label={t(lang, 'openMenu')}
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-label-open={t(lang, 'openMenu')}
        data-label-close={t(lang, 'closeMenu')}
        data-mobile-open
      >
        <span class="hdr__burger-line"></span>
        <span class="hdr__burger-line"></span>
        <span class="hdr__burger-line"></span>
      </button>
    </div>
  </div>

  <div
    id="mobile-menu"
    class="mmenu"
    role="dialog"
    aria-modal="true"
    aria-label={t(lang, 'menu')}
    data-mobile-panel
    hidden
    inert
  >
    <nav class="mmenu__body" aria-label={t(lang, 'navPrimaryLabel')}>
      {
        navGroups.map(({ item, links }, index) => (
          <div class="mmenu__group" data-mgroup>
            <div class="mmenu__row">
              <a
                href={localizePath(item.path, lang)}
                class="mmenu__link"
                aria-current={isCurrent(item.path) ? 'page' : undefined}
              >
                {t(lang, item.key)}
              </a>
              {links.length > 0 && (
                <button
                  type="button"
                  class="mmenu__toggle"
                  aria-expanded="false"
                  aria-controls={`mm-${index}`}
                  aria-label={`${t(lang, item.key)}: ${t(lang, 'navShowSections')}`}
                  data-mgroup-toggle
                >
                  <svg
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="m6 9 6 6 6-6" />
                  </svg>
                </button>
              )}
            </div>
            {links.length > 0 && (
              <div class="mmenu__sub" id={`mm-${index}`} data-mgroup-panel>
                <ul class="mmenu__sublist">
                  {links.map((link) => (
                    <li>
                      <a href={link.href} class="mmenu__sublink" tabindex="-1">
                        {link.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </div>
        ))
      }
      <div class="mmenu__actions">
        <a href={donateHref(lang)} class="mmenu__cta mmenu__cta--solid">
          {t(lang, 'donate')}
        </a>
        <a href={localizePath('/contact?topic=partner', lang)} class="mmenu__cta">
          {t(lang, 'contactUs')}
        </a>
      </div>
    </nav>
  </div>
</header>

<script>
  import { initDropdowns, initMenus } from '~/lib/menu';
  import { initHeaderMotion } from '~/lib/header-motion';

  initMenus();
  initDropdowns();
  initHeaderMotion();
</script>

<style>
  .hdr {
    position: sticky;
    top: 0;
    z-index: 40;
    box-sizing: border-box;
    height: var(--header-h);
    --hdr-gutter: clamp(1rem, 2.5vw, 2.25rem);
    padding: var(--safe-top) max(var(--hdr-gutter), var(--safe-right)) 0
      max(var(--hdr-gutter), var(--safe-left));
    background: #fff;
    border-bottom: 1px solid var(--color-line);
    --hdr-ink: #000;
    color: var(--hdr-ink);
    font-family: var(--font-sans);
    --hdr-control-h: 40px;
    transition:
      background-color var(--duration-ui) var(--ease-ui),
      border-color var(--duration-ui) var(--ease-ui),
      color var(--duration-ui) var(--ease-ui);
  }
  .hdr__bar {
    max-width: 90.5rem;
    height: 100%;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }
  .hdr__brand {
    display: flex;
    align-items: center;
    min-width: 0;
    margin-inline-start: clamp(0.25rem, 0.75vw, 0.875rem);
    text-decoration: none;
  }
  .hdr :global(.hdr__logo) {
    display: block;
    height: 64px;
    width: auto;
    max-width: 100%;
    object-fit: contain;
  }
  .hdr :global(.hdr__logo--reversed) {
    display: none;
  }

  /* --- Links ------------------------------------------------------------- */
  .hdr__nav {
    display: none;
    align-items: center;
    white-space: nowrap;
  }
  .hdr__item {
    position: relative;
    display: flex;
    align-items: center;
    height: var(--hdr-control-h);
    padding-inline: 0.25rem;
    border-radius: var(--radius-md);
    transition: background-color var(--duration-ui) var(--ease-ui);
  }
  .hdr__item[data-open] {
    background: var(--color-blue-50);
  }
  .hdr__link {
    display: flex;
    align-items: center;
    height: 100%;
    padding-inline: 0.5rem;
    color: inherit;
    font-weight: 500;
    text-decoration: none;
    transition: opacity var(--duration-ui) var(--ease-ui);
  }
  .hdr__link:hover {
    opacity: 0.6;
  }
  .hdr__link[aria-current] {
    font-weight: 600;
  }
  /* Both languages share one grid cell, so the slot is as wide as the longer
     label and nothing shifts when the language changes. */
  .hdr__labels {
    display: grid;
    place-items: center;
  }
  .hdr__label {
    grid-area: 1 / 1;
    visibility: hidden;
    font-size: 16px;
    line-height: 1.2;
  }
  :global(html[lang='en']) .hdr__label--en,
  :global(html[lang='km']) .hdr__label--km {
    visibility: visible;
  }
  .hdr__chev {
    display: grid;
    place-items: center;
    width: 24px;
    height: 100%;
    margin-inline-start: -0.375rem;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    cursor: pointer;
  }
  .hdr__chev svg {
    transition: transform 360ms var(--ease-reveal);
  }
  .hdr__chev[aria-expanded='true'] svg {
    transform: rotate(180deg);
  }

  .dd {
    --hdr-ink: #000;
    position: absolute;
    top: 100%;
    inset-inline-start: 0;
    z-index: 2;
    width: clamp(18rem, 23vw, 22rem);
    padding-top: calc((var(--header-h) - var(--safe-top) - var(--hdr-control-h)) / 2 + 0.25rem);
    display: grid;
    grid-template-rows: 0fr;
    visibility: hidden;
    pointer-events: none;
    transition:
      grid-template-rows 420ms var(--ease-reveal),
      visibility 0s linear 420ms;
  }
  .hdr__item[data-open] > .dd {
    z-index: 3;
    grid-template-rows: 1fr;
    visibility: visible;
    pointer-events: auto;
    transition-delay: 0s;
  }
  .dd__inner {
    min-height: 0;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: #fff;
    box-shadow:
      0 4px 24px rgb(14 21 51 / 0.12),
      0 16px 32px -16px rgb(14 21 51 / 0.28);
    /* Fades out with the collapse: a zero-height box still draws its edges. */
    opacity: 0;
    transition: opacity 200ms ease;
  }
  .hdr__item[data-open] > .dd > .dd__inner {
    opacity: 1;
  }
  .dd__list {
    max-height: min(26rem, calc(100vh - var(--header-h) - 1rem));
    max-height: min(26rem, calc(100dvh - var(--header-h) - 1rem));
    margin: 0;
    padding: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    list-style: none;
  }
  .dd__list li {
    opacity: 0;
    translate: 0 -0.5rem;
    transition:
      opacity 200ms ease,
      translate 200ms ease;
  }
  .hdr__item[data-open] .dd__list li {
    opacity: 1;
    translate: 0 0;
    transition-delay: calc(90ms + var(--i) * 45ms);
  }
  .dd__link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    min-height: 3rem;
    padding: 0.75rem 1rem;
    color: var(--hdr-ink);
    font-weight: 600;
    line-height: 1.4;
    text-decoration: none;
    white-space: normal;
    transition: background-color var(--duration-fast) var(--ease-out-soft);
  }
  .dd__link span {
    min-width: 0;
    overflow-wrap: anywhere;
  }
  .dd__link svg {
    flex: none;
    color: var(--color-blue-700);
  }
  .dd__link:is(:hover, :focus-visible) {
    background: var(--color-blue-50);
  }
  .dd__link:focus-visible {
    outline: 2px solid var(--color-blue-700);
    outline-offset: -2px;
  }
  /* --- Tools: language switch, call to action, menu button ---------------- */
  .hdr__tools {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
  }
  .hdr__toggle-desktop {
    display: none;
  }
  .hdr__pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    height: var(--hdr-control-h);
    padding: 0 0.875rem;
    border-radius: var(--radius-cta);
    background: var(--color-blue-700);
    color: #fff;
    font-size: 14px;
    font-weight: 500;
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
    transition: background-color var(--duration-ui) var(--ease-ui);
  }
  .hdr__pill:is(:hover, :focus-visible) {
    background: var(--color-blue-800);
  }
  .hdr__pill:focus-visible {
    outline: 2px solid var(--color-blue-800);
    outline-offset: 3px;
  }
  .hdr__burger {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 3px;
    width: 44px;
    height: 44px;
    margin-inline-end: -10px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--hdr-ink);
    cursor: pointer;
  }
  .hdr__burger-line {
    width: 18px;
    height: 2px;
    background: currentColor;
    transition:
      transform 400ms ease,
      opacity 400ms ease;
  }
  .hdr__burger[aria-expanded='true'] .hdr__burger-line:nth-child(1) {
    transform: translate3d(0, 5px, 0) rotate(45deg);
  }
  .hdr__burger[aria-expanded='true'] .hdr__burger-line:nth-child(2) {
    opacity: 0;
  }
  .hdr__burger[aria-expanded='true'] .hdr__burger-line:nth-child(3) {
    transform: translate3d(0, -5px, 0) rotate(-45deg);
  }

  .hdr__tools :global(.lang-toggle) {
    border-color: var(--color-line-strong);
  }
  .hdr__toggle-desktop :global(.lang-toggle) {
    height: var(--hdr-control-h);
    box-sizing: border-box;
  }
  .hdr__tools :global(.lang-toggle__link) {
    display: inline-flex;
    flex: 1;
    align-items: center;
    padding: 0 12px;
    color: inherit;
    opacity: 0.72;
    transition:
      background-color var(--duration-ui) var(--ease-ui),
      opacity var(--duration-ui) var(--ease-ui);
  }
  .hdr__toggle-phone :global(.lang-toggle__link) {
    min-block-size: 42px;
  }
  .hdr__tools :global(.lang-toggle__link:hover) {
    opacity: 1;
  }
  .hdr__tools :global(.lang-toggle__link.is-current) {
    background: var(--color-blue-50);
    font-weight: 600;
    opacity: 1;
  }

  /* --- Phone menu: fills the window under the bar, fading in -------------- */
  .mmenu {
    position: fixed;
    inset: var(--header-h) 0 0;
    z-index: 1;
    overflow-y: auto;
    overscroll-behavior: contain;
    background: #fff;
    color: var(--hdr-ink);
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 400ms ease,
      visibility 0s linear 400ms;
  }
  .mmenu[data-state='open'] {
    opacity: 1;
    visibility: visible;
    transition-delay: 0s;
  }
  .mmenu__body {
    display: flex;
    flex-direction: column;
    padding: 0.5rem var(--gutter-right) calc(2rem + var(--safe-bottom)) var(--gutter-left);
  }
  .mmenu__row {
    display: flex;
    align-items: center;
    border-bottom: 1px solid var(--color-line);
  }
  .mmenu__link {
    flex: 1;
    min-height: 44px;
    padding: 1rem 0;
    color: var(--hdr-ink);
    font-size: 19px;
    font-weight: 600;
    text-decoration: none;
  }
  .mmenu__toggle {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    margin-inline-end: -12px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--color-blue-700);
    cursor: pointer;
  }
  .mmenu__toggle[aria-expanded='true'] svg {
    transform: rotate(180deg);
  }
  .mmenu__sub {
    display: none;
  }
  .mmenu__group[data-open] .mmenu__sub {
    display: block;
  }
  .mmenu__sublist {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .mmenu__sublink {
    display: flex;
    align-items: center;
    min-height: 44px;
    padding: 0.625rem 0 0.625rem 1rem;
    border-bottom: 1px solid var(--color-line);
    color: var(--hdr-ink);
    font-size: 16px;
    font-weight: 500;
    text-decoration: none;
  }
  .mmenu a:hover {
    color: var(--color-blue-700);
  }
  .mmenu__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }
  .mmenu__cta {
    display: inline-flex;
    align-items: center;
    padding: 1rem 1.5rem;
    border: 1px solid var(--color-line-strong);
    border-radius: var(--radius-cta);
    color: var(--hdr-ink);
    font-size: 16px;
    font-weight: 500;
    line-height: 1;
    text-decoration: none;
    transition:
      background-color var(--duration-ui) var(--ease-ui),
      border-color var(--duration-ui) var(--ease-ui);
  }
  .mmenu__cta:hover {
    border-color: var(--color-blue-200);
    background: var(--color-blue-50);
  }
  .mmenu .mmenu__cta--solid {
    border-color: var(--color-blue-700);
    background: var(--color-blue-700);
    color: #fff;
  }
  .mmenu .mmenu__cta--solid:hover {
    border-color: var(--color-blue-800);
    background: var(--color-blue-800);
    color: #fff;
  }
  :global([data-menu-open]) {
    overflow: hidden;
  }

  /* Home, while over the hero photo: no surface, white ink.
     Without scripts the bar would never turn white again, so it starts white. */
  @media (scripting: enabled) {
    :global(html:not([data-menu-open])) .hdr[data-home]:not([data-solid]) {
      --hdr-ink: #fff;
      border-bottom-color: transparent;
      background: linear-gradient(rgb(18 16 14 / 0.65), rgb(18 16 14 / 0.3) 65%, rgb(18 16 14 / 0))
        border-box;
    }
    :global(html:not([data-menu-open])) .hdr[data-home]:not([data-solid]) :global(.hdr__logo) {
      display: none;
    }
    :global(html:not([data-menu-open]))
      .hdr[data-home]:not([data-solid])
      :global(.hdr__logo--reversed) {
      display: block;
    }
    :global(html:not([data-menu-open])) .hdr[data-home]:not([data-solid]) .hdr__link {
      text-shadow: 0 1px 8px rgb(0 0 0 / 0.35);
    }
    :global(html:not([data-menu-open])) .hdr[data-home]:not([data-solid]) .hdr__item[data-open] {
      background: rgb(255 255 255 / 0.18);
    }
    :global(html:not([data-menu-open]))
      .hdr[data-home]:not([data-solid])
      .hdr__tools
      :global(.lang-toggle) {
      border-color: rgb(255 255 255 / 0.7);
    }
    :global(html:not([data-menu-open]))
      .hdr[data-home]:not([data-solid])
      .hdr__tools
      :global(.lang-toggle__link.is-current) {
      background: rgb(255 255 255 / 0.22);
    }
    :global(html:not([data-menu-open]))
      .hdr[data-home]:not([data-solid])
      .hdr__bar
      > a:focus-visible,
    :global(html:not([data-menu-open]))
      .hdr[data-home]:not([data-solid])
      .hdr__bar
      :is(.hdr__link, .hdr__chev, .hdr__pill, .hdr__burger):focus-visible,
    :global(html:not([data-menu-open]))
      .hdr[data-home]:not([data-solid])
      .hdr__tools
      :global(.lang-toggle__link:focus-visible) {
      outline-color: #fff;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hdr,
    .hdr *,
    .mmenu,
    .dd {
      transition-duration: 0s !important;
      transition-delay: 0s !important;
    }
  }

  @media (width < 30rem) {
    .hdr :global(.hdr__logo) {
      height: 56px;
    }
    .hdr__tools {
      gap: 0.375rem;
    }
    .hdr__pill {
      padding: 0 0.625rem;
      font-size: 13px;
    }
    .hdr__toggle-phone :global(.lang-toggle__link) {
      min-inline-size: 2.25rem;
      padding-inline: 8px;
    }
  }
  /* Narrowest phones: the call to action is also in the menu. */
  @media (width < 22.5rem) {
    .hdr__pill {
      display: none;
    }
  }

  @media (min-width: 62rem) {
    .hdr :global(.hdr__logo) {
      height: 72px;
    }
    .hdr__pill {
      padding: 0 1.25rem;
      font-size: 15px;
    }
  }

  @media (min-width: 75rem) {
    .hdr :global(.hdr__logo) {
