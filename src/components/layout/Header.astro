---
import { htmlLang, locales, type Locale } from '~/lib/i18n/config';
import type { SiteSettings } from '~/lib/content/types';
import { getPrograms } from '~/lib/content';
import { localizePath, parsePath, pick, t, text } from '~/lib/i18n/utils';
import { mainNav } from '~/lib/nav';
import { aboutSubpages, availableAboutGroups } from '~/lib/about-groups';
import { impactProjectsAvailable, impactProjectsPath } from '~/lib/impact-pages';
import { donateHref } from '~/lib/skeleton-content';
import LanguageToggle from './LanguageToggle.astro';
import Logo from '~/components/Logo.astro';

interface Props {
  lang: Locale;
  pathname: string;
  settings: SiteSettings;
}

const { lang, pathname, settings } = Astro.props;

const orgName = text(settings.orgName, lang);

const current = parsePath(pathname).path.replace(/\/$/, '') || '/';
const [programs, aboutGroups, hasImpactProjects] = await Promise.all([
  getPrograms(),
  availableAboutGroups(lang),
  impactProjectsAvailable(lang),
]);
const shownAbout = new Set(aboutGroups.map((group) => group.path));
const hiddenPaths = new Set(
  aboutSubpages.map((group) => group.path).filter((path) => !shownAbout.has(path)),
);
if (!hasImpactProjects) hiddenPaths.add(impactProjectsPath);
const dropdownLinks = (item: (typeof mainNav)[number]) => {
  if (item.programs) {
    return programs.flatMap((program) => {
      const label = pick(program.title, lang).value;
      return label ? [{ label, href: localizePath(`/programs/${program.slug}`, lang) }] : [];
    });
  }
  return (item.sections ?? [])
    .filter((section) => !section.path || !hiddenPaths.has(section.path))
    .map((section) => ({
      label: t(lang, section.key),
      href: section.path
        ? localizePath(section.path, lang)
        : current === item.path
          ? `#${section.id}`
          : `${localizePath(item.path, lang)}#${section.id}`,
    }));
};
const isCurrent = (path: string) => current === path || current.startsWith(`${path}/`);
const mobileGroups = mainNav.map((item) => ({ item, links: dropdownLinks(item) }));
---

<header class="hdr site-header" data-header>
  <div class="hdr__bar">
    <a href={localizePath('/', lang)} class="hdr__brand">
      <Logo variant="full" height={82} title={orgName} class="hdr__logo" />
      <Logo variant="reversed" height={82} title={orgName} class="hdr__logo" />
    </a>

    <nav class="hdr__nav" aria-label={t(lang, 'navPrimaryLabel')}>
      {
        mainNav.map((item, index) => {
          const links = dropdownLinks(item);
          const menuId = `dd-${index}`;
          return (
            <div class="hdr__item" data-nav-item>
              <a
                href={localizePath(item.path, lang)}
                class="nav-link hdr__link"
                aria-current={isCurrent(item.path) ? 'page' : undefined}
              >
                <span class="hdr__labels">
                  {locales.map((locale) => (
                    <span
                      class:list={['hdr__label', `hdr__label--${locale}`]}
                      lang={htmlLang[locale]}
                    >
                      {t(locale, item.key)}
                    </span>
                  ))}
                </span>
              </a>
              {links.length > 0 && (
                <>
                  <button
                    type="button"
                    class="hdr__chev"
                    aria-expanded="false"
                    aria-controls={menuId}
                    aria-label={`${t(lang, item.key)}: ${t(lang, 'navShowSections')}`}
                    data-dd-toggle
                  >
                    <svg
                      width="13"
                      height="13"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d="m6 9 6 6 6-6" />
                    </svg>
                  </button>
                  <div class="dd" id={menuId} data-dd>
                    <div class="dd__inner">
                      <ul class="dd__list">
                        {links.map((link, i) => (
                          <li style={`--i:${i}`}>
                            <a href={link.href} class="dd__link" tabindex="-1">
                              <span>{link.label}</span>
                              <svg
                                width="16"
                                height="16"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2.2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                aria-hidden="true"
                              >
                                <path d="m9 6 6 6-6 6" />
                              </svg>
                            </a>
                          </li>
                        ))}
                      </ul>
                    </div>
                  </div>
                </>
              )}
            </div>
          );
        })
      }
    </nav>

    <div class="hdr__tools">
      <span class="hdr__toggle-desktop">
        <LanguageToggle lang={lang} pathname={pathname} />
      </span>
      <span class="hdr__toggle-phone">
        <LanguageToggle lang={lang} pathname={pathname} variant="phone" />
      </span>
      <a href={localizePath('/contact?topic=partner', lang)} class="hdr__pill"
        >{t(lang, 'contactUs')}</a
      >
      <button
        type="button"
        class="hdr__burger"
        aria-label={t(lang, 'openMenu')}
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-mobile-open
      >
        <svg
          width="22"
          height="22"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"></path></svg
        >
      </button>
    </div>
  </div>

  <div
    id="mobile-menu"
    class="mmenu"
    role="dialog"
    aria-modal="true"
    aria-label={t(lang, 'menu')}
    data-mobile-panel
    hidden
  >
    <div class="mmenu__bar">
      <a href={localizePath('/', lang)} class="hdr__brand">
        <Logo variant="full" height={56} title={orgName} class="hdr__logo" />
      </a>
      <button type="button" class="hdr__burger" aria-label={t(lang, 'closeMenu')} data-mobile-close>
        <svg
          width="22"
          height="22"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg
        >
      </button>
    </div>
    <nav class="mmenu__body" aria-label={t(lang, 'navPrimaryLabel')}>
      {
        mobileGroups.map(({ item, links }, index) => (
          <div class="mmenu__group" data-mgroup>
            <div class="mmenu__row">
              <a
                href={localizePath(item.path, lang)}
                class="mmenu__link"
                aria-current={isCurrent(item.path) ? 'page' : undefined}
              >
                {t(lang, item.key)}
              </a>
              {links.length > 0 && (
                <button
                  type="button"
                  class="mmenu__toggle"
                  aria-expanded="false"
                  aria-controls={`mm-${index}`}
                  aria-label={`${t(lang, item.key)}: ${t(lang, 'navShowSections')}`}
                  data-mgroup-toggle
                >
                  <svg
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="m6 9 6 6 6-6" />
                  </svg>
                </button>
              )}
            </div>
            {links.length > 0 && (
              <div class="mmenu__sub" id={`mm-${index}`} data-mgroup-panel>
                <ul class="mmenu__sublist">
                  {links.map((link) => (
                    <li>
                      <a href={link.href} class="mmenu__sublink" tabindex="-1">
                        {link.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </div>
        ))
      }
      <div class="mmenu__actions">
        <a href={donateHref(lang)} class="mega__pill mmenu__contact">
          {t(lang, 'donate')}
        </a>
        <a href={localizePath('/contact?topic=partner', lang)} class="mega__pill">
          {t(lang, 'contactUs')}
        </a>
      </div>
    </nav>
  </div>
</header>

<script>
  import { initDropdowns, initMenus } from '~/lib/menu';
  import { initHeaderScroll } from '~/lib/header-scroll';

  initMenus();
  initDropdowns();
  initHeaderScroll();
</script>

<style>
  .hdr {
    position: sticky;
    top: 0;
    z-index: 40;
    box-sizing: border-box;
    height: var(--header-h);
    background: transparent;
    border-bottom: 0;
    padding: var(--safe-top) clamp(16px, 3vw, 24px) 0;
    /* One ink for the whole bar, set once per page (see the dark-hero rule
       below). Nothing here recolours element by element on scroll. */
    --hdr-fg: var(--color-blue-800);
    --hdr-line: var(--color-line-strong);
    --hdr-ease: cubic-bezier(0.22, 1, 0.36, 1);
    --hdr-pill-bg: var(--color-blue-700);
    --hdr-pill-fg: #fff;
    --hdr-pill-hover: var(--color-blue-800);
    --hdr-soft: var(--color-blue-50);
    --hdr-scrolled: rgb(255 255 255 / 0.82);
    /* One height for the link group, the language toggle and the Contact pill. */
    --hdr-control-h: 40px;
    color: var(--hdr-fg);
    font-family: var(--font-sans);
  }
  /* Once the page moves, only the link group takes a faint frosted surface so
     the links stay legible; the logo and the actions keep floating. A page
     whose top is split light/dark (data-nav-solid) keeps it from the start. */
  .hdr[data-scrolled] .hdr__nav,
  :global(:root:has(main > [data-nav-solid]:first-child)) .hdr__nav {
    background: var(--hdr-scrolled);
    -webkit-backdrop-filter: blur(20px) saturate(1.4);
    backdrop-filter: blur(20px) saturate(1.4);
    box-shadow: 0 0 0 1px var(--hdr-line);
  }
  .hdr__bar {
    max-width: 1360px;
    height: 100%;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: clamp(12px, 2vw, 24px);
  }
  .hdr__brand {
    display: flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
    flex-shrink: 0;
    text-decoration: none;
  }
  .hdr :global(.hdr__logo),
  .mmenu :global(.hdr__logo) {
    display: block;
    height: 56px;
    width: auto;
    flex-shrink: 0;
  }

  .hdr__nav {
    display: none;
    align-items: center;
    gap: 2px;
    font-size: clamp(15px, 0.3vw + 11px, 16px);
    font-weight: 500;
    white-space: nowrap;
  }
  /* Both languages are rendered in the same grid cell, so the slot is as wide
     as the longer of the two and every item starts at the same x in either
     language. Only the active one is visible; the hidden one still measures. */
  .hdr__labels {
    display: grid;
    place-items: center;
  }
  .hdr__label {
    grid-area: 1 / 1;
    visibility: hidden;
    text-align: center;
  }
  .hdr__label--en {
    font-size: 16px;
    font-weight: 500;
    letter-spacing: -0.005em;
    line-height: 1.2;
  }
  .hdr__label--km {
    font-size: clamp(15px, 0.3vw + 11px, 16px);
    font-weight: 500;
  }
  :global(html[lang='en']) .hdr__label--en,
  :global(html[lang='km']) .hdr__label--km {
    visibility: visible;
  }
  .hdr__link::after {
    height: 1.5px;
    background: currentColor;
    transform-origin: center;
    transition:
      transform 360ms var(--hdr-ease),
      opacity 360ms var(--hdr-ease);
  }
  .hdr__link[aria-current]::after {
    opacity: 0.45;
  }
  .hdr__link:hover::after {
    opacity: 1;
  }
  .hdr__link {
    color: var(--hdr-fg);
  }
  .hdr__link:hover,
  .hdr__link[aria-current] {
    color: var(--hdr-fg);
  }
  :global(html[lang='en']) .hdr__link {
    font-size: 16px;
    font-weight: 500;
    letter-spacing: -0.005em;
  }
  :global(html[lang='en']) .hdr__pill {
    font-size: 15px;
    font-weight: 500;
    letter-spacing: -0.005em;
  }
  :global(html[lang='en']) .hdr :global(.lang-toggle) {
    font-size: 14px;
  }
  .hdr__item {
    position: relative;
    display: flex;
    align-items: center;
    align-self: stretch;
  }
  .hdr__chev {
    display: grid;
    place-items: center;
    width: 24px;
    height: 32px;
    margin-inline-start: -16px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--hdr-fg);
    cursor: pointer;
  }
  .hdr__chev svg {
    transition: transform 360ms var(--ease-reveal, cubic-bezier(0.16, 1, 0.3, 1));
  }
  .hdr__chev[aria-expanded='true'] {
    color: var(--hdr-fg);
  }
  .hdr__chev[aria-expanded='true'] svg {
    transform: rotate(180deg);
  }

  /* Drop-down: the panel grows out of the header's bottom edge. Rows take
     0fr → 1fr so the height animates without measuring, each row settles in a beat after the one above. */
  .dd {
    position: absolute;
    top: 100%;
    inset-inline-start: 0;
    z-index: 5;
    min-width: 18rem;
    max-width: 24rem;
    padding-top: 8px;
    display: grid;
    grid-template-rows: 0fr;
    visibility: hidden;
    pointer-events: none;
    transition:
      grid-template-rows 420ms cubic-bezier(0.16, 1, 0.3, 1),
      visibility 0s linear 420ms;
  }
  .dd__inner {
    min-height: 0;
    overflow: hidden;
    background: #fff;
    border-radius: 16px;
    box-shadow:
      0 0 0 1px rgb(15 23 42 / 0.05),
      0 24px 40px -18px rgb(15 23 42 / 0.35);
  }
  .dd__list {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .dd__list li + li {
    border-top: 1px solid var(--color-line);
  }
  .dd__list li {
    opacity: 0;
    translate: 0 -8px;
    transition:
      opacity 200ms ease,
      translate 200ms ease;
  }
  .dd__link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 17px 20px;
    color: var(--color-ink-900);
    font-size: 16px;
    font-weight: 600;
    line-height: 1.35;
    text-decoration: none;
    white-space: normal;
    transition:
      background-color var(--duration-fast) var(--ease-out-soft),
      color var(--duration-fast) var(--ease-out-soft),
      padding-inline-start 260ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .dd__link svg {
    flex: none;
    color: var(--color-blue-700);
    transition: translate 260ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .dd__link:is(:hover, :focus-visible) {
    background: var(--color-surface-subtle);
    color: var(--color-blue-800);
    padding-inline-start: 26px;
  }
  .dd__link:is(:hover, :focus-visible) svg {
    translate: 4px 0;
  }
  .hdr__item[data-open] > .dd {
    grid-template-rows: 1fr;
    visibility: visible;
    pointer-events: auto;
    transition-delay: 0s, 0s;
  }
  .hdr__item[data-open] .dd__list li {
    opacity: 1;
    translate: 0 0;
    transition-delay: calc(90ms + var(--i) * 45ms);
  }
  @media (prefers-reduced-motion: reduce) {
    .hdr__nav,
    .hdr::before,
    .hdr__link::after,
    .hdr__pill,
    .hdr__tools :global(.lang-toggle__link),
    .dd,
    .dd__list li,
    .hdr__chev svg {
      transition-duration: 0s !important;
      transition-delay: 0s !important;
    }
  }

  .hdr__tools {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
  }
  .hdr__toggle-desktop,
  .hdr__pill {
    display: none;
  }
  .hdr__pill {
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    height: var(--hdr-control-h);
    min-inline-size: 144px;
    padding: 0 1.25rem;
    border-radius: var(--radius-cta);
    background: var(--hdr-pill-bg);
    color: var(--hdr-pill-fg);
    font-weight: 500;
    font-size: 15px;
    text-decoration: none;
    white-space: nowrap;
    transition: background-color var(--duration-ui) var(--ease-ui);
  }
  .hdr__pill:is(:hover, :focus-visible) {
    background: var(--hdr-pill-hover);
  }
  .hdr__pill:focus-visible {
    outline: 2px solid var(--hdr-fg);
    outline-offset: 3px;
  }
  .hdr__burger {
    width: 42px;
    height: 42px;
    border: 1px solid var(--color-line-strong);
    border-radius: 10px;
    background: #fff;
    color: var(--color-ink-900);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    padding: 0;
  }

  .hdr :global(.logo--reversed) {
    display: none;
  }
  .hdr__tools :global(.lang-toggle) {
    gap: 2px;
    padding: 3px;
    border-color: var(--hdr-line);
  }
  .hdr__toggle-desktop :global(.lang-toggle) {
    height: var(--hdr-control-h);
    box-sizing: border-box;
  }
  .hdr__tools :global(.lang-toggle__link) {
    display: inline-flex;
    align-items: center;
    padding: 0 12px;
    border-radius: 999px;
    color: var(--hdr-fg);
    opacity: 0.72;
    transition:
      background-color 360ms var(--hdr-ease),
      color 360ms var(--hdr-ease),
      opacity 360ms var(--hdr-ease);
  }
  .hdr__tools :global(.lang-toggle__link:hover) {
    background: color-mix(in srgb, var(--hdr-soft) 55%, transparent);
    opacity: 1;
  }
  .hdr__tools :global(.lang-toggle__link.is-current) {
    background: var(--hdr-soft);
    color: var(--hdr-fg);
    font-weight: 600;
    opacity: 1;
  }

  /* The logo and actions float with no surface behind them, so the ink follows
     whatever is under the bar: header-scroll.ts sets data-tone from the content
     beneath it. Before that runs, a page opening on a dark hero starts white
     and every other page starts dark blue. */
  :global(:root:has(main > [data-hero-dark]:first-child)) .hdr:not([data-tone]),
  .hdr[data-tone='dark'] {
    --hdr-fg: #fff;
    --hdr-line: rgb(255 255 255 / 0.28);
    --hdr-soft: rgb(255 255 255 / 0.18);
    --hdr-scrolled: rgb(14 21 51 / 0.8);
  }
  :global(:root:has(main > [data-hero-dark]:first-child)) .hdr::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 140%;
    z-index: -1;
    pointer-events: none;
    background: linear-gradient(to bottom, rgb(18 16 14 / 0.3), rgb(18 16 14 / 0));
    transition: opacity 400ms var(--hdr-ease);
  }
  :global(:root:has(main > [data-hero-dark]:first-child)) .hdr[data-scrolled]::before {
    opacity: 0;
  }
  :global(:root:has(main > [data-hero-dark]:first-child))
    .hdr:not([data-tone])
    .hdr__bar
    :global(.logo--full),
  .hdr[data-tone='dark'] .hdr__bar :global(.logo--full) {
    display: none;
  }
  :global(:root:has(main > [data-hero-dark]:first-child))
    .hdr:not([data-tone])
    .hdr__bar
    :global(.logo--reversed),
  .hdr[data-tone='dark'] .hdr__bar :global(.logo--reversed) {
    display: block;
  }
  .hdr[data-brand-tone='dark'] .hdr__bar :global(.logo--full),
  .hdr[data-brand-tone='light'] .hdr__bar :global(.logo--reversed) {
    display: none;
  }
  .hdr[data-brand-tone='dark'] .hdr__bar :global(.logo--reversed),
  .hdr[data-brand-tone='light'] .hdr__bar :global(.logo--full) {
    display: block;
  }
  /* Over the contact page's dark column the logo starts white, so the first
     paint, and the page-switch snapshot taken of it, already match what
     header-scroll.ts settles on. */
  @media (min-width: 56rem) {
    :global(:root:has(main > [data-nav-solid]:first-child))
      .hdr:not([data-brand-tone])
      .hdr__bar
      :global(.logo--full) {
      display: none;
    }
    :global(:root:has(main > [data-nav-solid]:first-child))
      .hdr:not([data-brand-tone])
      .hdr__bar
      :global(.logo--reversed) {
      display: block;
    }
  }

  @media (min-width: 75rem) {
    .hdr__nav {
      box-sizing: border-box;
      height: var(--hdr-control-h);
      padding-inline: 8px;
      border-radius: 999px;
      background: transparent;
      transition:
        background-color 400ms var(--hdr-ease),
        box-shadow 400ms var(--hdr-ease);
    }
  }

  .mega__pill {
    display: inline-flex;
    align-items: center;
    color: var(--color-ink-900);
    text-decoration: none;
    font-size: 16px;
    font-weight: 500;
    line-height: 1;
    border: 1px solid var(--color-line-strong);
    border-radius: var(--radius-cta);
    padding: 1rem 1.5rem;
    transition:
      background-color var(--duration-ui) var(--ease-ui),
      border-color var(--duration-ui) var(--ease-ui),
      color var(--duration-ui) var(--ease-ui);
  }
  .mmenu a:hover {
    color: var(--color-blue-700);
  }
  .mega__pill:hover {
    border-color: var(--color-blue-200);
    background: var(--color-blue-50);
  }

  .mmenu {
    position: fixed;
    inset: 0;
    z-index: 60;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    color: var(--color-ink-600);
    visibility: hidden;
    transition: visibility 0s linear 160ms;
  }
  .mmenu::before {
    content: '';
    position: absolute;
    inset: 0;
    background: rgb(10 18 40 / 0.42);
    opacity: 0;
    transition: opacity 160ms cubic-bezier(0.4, 0, 1, 1);
  }
  .mmenu[data-state='open'] {
    visibility: visible;
    transition: visibility 0s;
  }
  .mmenu[data-state='open']::before {
    opacity: 1;
    transition-duration: 220ms;
    transition-timing-function: cubic-bezier(0.2, 0, 0, 1);
  }
  .mmenu__bar {
    position: relative;
    z-index: 2;
    flex: none;
    box-sizing: border-box;
    height: var(--header-h);
    padding: var(--safe-top) 16px 0;
    background: #fff;
    border-bottom: 1px solid var(--color-line);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
  }
  .mmenu__body {
    position: relative;
    z-index: 1;
    flex: none;
    max-height: calc(100% - var(--header-h));
    overflow-y: auto;
    padding: 8px 24px calc(24px + var(--safe-bottom));
    display: flex;
    flex-direction: column;
    background: #fff;
    border-radius: 0 0 20px 20px;
