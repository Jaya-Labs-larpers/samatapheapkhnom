---
import type { Locale } from '~/lib/i18n/config';
import type { SiteSettings } from '~/lib/content/types';
import { localizePath, t, text } from '~/lib/i18n/utils';
import LanguageToggle from './LanguageToggle.astro';
import Logo from '~/components/Logo.astro';

interface Props {
  lang: Locale;
  pathname: string;
  settings: SiteSettings;
}

const { lang, pathname, settings } = Astro.props;
const home = localizePath('/', lang);
---

<header class="mhdr site-header">
  <div class="mhdr__bar">
    <a href={home} class="mhdr__brand">
      <Logo variant="full" height={64} title={text(settings.orgName, lang)} class="mhdr__logo" />
    </a>
    <div class="mhdr__tools">
      <a href={home} class="mhdr__back">
        <span aria-hidden="true">←</span>
        {t(lang, 'donateBack')}
      </a>
      <LanguageToggle lang={lang} pathname={pathname} />
    </div>
  </div>
</header>

<style>
  .mhdr {
    box-sizing: border-box;
    padding: var(--safe-top) clamp(16px, 3vw, 24px) 0;
    border-bottom: 1px solid var(--color-line);
    font-family: var(--font-sans);
  }
  .mhdr__bar {
    max-width: 1360px;
    height: 100%;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }
  .mhdr :global(.mhdr__logo) {
    display: block;
    width: auto;
    height: 52px;
  }
  .mhdr__tools {
    display: flex;
    align-items: center;
    gap: clamp(12px, 2vw, 24px);
  }
  .mhdr__back {
    display: inline-flex;
    gap: 8px;
    color: var(--color-ink-700);
    font-size: 15px;
    font-weight: 500;
    text-decoration: none;
    transition: color 360ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .mhdr__back span {
    transition: translate 360ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .mhdr__back:hover {
    color: var(--color-blue-800);
  }
  .mhdr__back:hover span {
    translate: -3px 0;
  }
  @media (width < 40rem) {
    .mhdr__back {
      font-size: 0;
      gap: 0;
    }
    .mhdr__back span {
      font-size: 20px;
    }
  }
  @media (min-width: 64rem) {
    .mhdr :global(.mhdr__logo) {
      height: 64px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .mhdr__back,
    .mhdr__back span {
      transition: none;
    }
  }
</style>
