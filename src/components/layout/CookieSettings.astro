---
import type { Locale } from '~/lib/i18n/config';
import { localizePath, t } from '~/lib/i18n/utils';

interface Props {
  lang: Locale;
  containerId: string;
}

const { lang, containerId } = Astro.props;
const labels = lang === 'km' ? {
  title: 'ការកំណត់ខូគី',
  message: 'យើងប្រើខូគីជាជម្រើស ដើម្បីដឹងថាទំព័រណាមានប្រយោជន៍បំផុតសម្រាប់អ្នកអាន ដើម្បីកែលម្អគេហទំព័រនេះ។ គេហទំព័រដំណើរការពេញលេញទោះបីអ្នកជ្រើសរើសបែបណាក៏ដោយ។',
  accept: 'យល់ព្រមទាំងអស់',
  reject: 'បដិសេធខូគីជាជម្រើស',
  preferences: 'ការកំណត់',
  necessary: 'ចាំបាច់',
  necessaryText: 'ចងចាំជម្រើសខូគីរបស់អ្នក។',
  alwaysOn: 'បើកជានិច្ច',
  analytics: 'ការវិភាគ',
  analyticsText: 'Google Analytics៖ ទំព័រណាដែលអ្នកអានចូលមើល និងអ្វីដែលពួកគេចុច។',
  save: 'រក្សាទុកជម្រើស',
} : {
  title: 'Cookie settings',
  message: 'We use optional cookies to see which pages help people most, so we can improve this site. The site works fully either way.',
  accept: 'Accept all',
  reject: 'Reject optional',
  preferences: 'Preferences',
  necessary: 'Necessary',
  necessaryText: 'Remembers your cookie choice.',
  alwaysOn: 'Always on',
  analytics: 'Analytics',
  analyticsText: 'Google Analytics: which pages people visit and what they click.',
  save: 'Save choices',
};
---

<div data-cookie-settings={containerId}>
  <button type="button" data-settings-toggle hidden aria-controls="cookie-panel" aria-expanded="false">{labels.title}</button>
  <section
    id="cookie-panel"
    aria-label={labels.title}
    hidden
  >
    <button type="button" class="close" data-action="reject" aria-label={labels.reject}>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg>
    </button>
    <div class="bar">
      <p>
        {labels.message}{' '}
        <a href={localizePath('/privacy', lang)}>{t(lang, 'navPrivacy')}</a>
      </p>
      <div class="choices">
        <button type="button" class="outline" data-action="preferences" aria-controls="cookie-preferences" aria-expanded="false">{labels.preferences}</button>
        <button type="button" class="solid" data-action="reject">{labels.reject}</button>
        <button type="button" class="solid" data-action="accept">{labels.accept}</button>
      </div>
    </div>
    <div id="cookie-preferences" class="preferences" hidden>
      <div class="row">
        <div>
          <strong>{labels.necessary}</strong>
          <span>{labels.necessaryText}</span>
        </div>
        <span class="always">{labels.alwaysOn}</span>
      </div>
      <div class="row">
        <div>
          <strong id="cookie-analytics-label">{labels.analytics}</strong>
          <span>{labels.analyticsText}</span>
        </div>
        <button type="button" role="switch" aria-checked="false" aria-labelledby="cookie-analytics-label" data-analytics-switch>
          <span class="thumb"></span>
        </button>
      </div>
      <div class="choices"><button type="button" class="solid" data-action="save">{labels.save}</button></div>
    </div>
  </section>
</div>

<script>
  import { whenSettled } from '~/lib/lazy';
  import { CONSENT_KEY, clearAnalyticsCookies, readChoice, saveChoice, type Choice } from '~/lib/consent';
  import { onPageLoad } from '~/lib/page-load';

  let started = false;

  onPageLoad((signal) => {
    const root = document.querySelector<HTMLElement>('[data-cookie-settings]');
    if (!root) return;
    const id = root.dataset.cookieSettings ?? '';
    const panel = root.querySelector<HTMLElement>('section')!;
    const toggle = root.querySelector<HTMLButtonElement>('[data-settings-toggle]')!;
    const preferences = root.querySelector<HTMLElement>('.preferences')!;
    const preferencesButton = root.querySelector<HTMLButtonElement>('[data-action="preferences"]')!;
    const analyticsSwitch = root.querySelector<HTMLButtonElement>('[data-analytics-switch]')!;
    const storage = (() => { try { return localStorage; } catch { return null; } })();
    let choice: Choice | null = null;
    let openedFromFooter = false;
    let leaving: number | undefined;
    const FADE_MS = 420;
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    function setSwitch(on: boolean) {
      analyticsSwitch.setAttribute('aria-checked', String(on));
    }

    function showPreferences(open: boolean) {
      preferences.hidden = !open;
      preferencesButton.setAttribute('aria-expanded', String(open));
      if (open) setSwitch(choice === 'accepted');
    }

    function show(open: boolean) {
      clearTimeout(leaving);
      panel.classList.remove('is-leaving');
      toggle.setAttribute('aria-expanded', String(open));
      if (open) {
        panel.hidden = false;
        return;
      }
      if (panel.hidden) {
        showPreferences(false);
        return;
      }
      panel.classList.add('is-leaving');
      leaving = window.setTimeout(() => {
        panel.hidden = true;
        panel.classList.remove('is-leaving');
        showPreferences(false);
      }, reducedMotion.matches ? 0 : FADE_MS);
    }

    function scheduleTags() {
      if (!id) return;
      whenSettled(() => {
        if (started || choice !== 'accepted' || ('prerendering' in document && document.prerendering)) return;
        started = true;
        const host = window as Window & { dataLayer?: unknown[] };
        (host.dataLayer ??= []).push({ 'gtm.start': Date.now(), event: 'gtm.js' });
        const script = document.createElement('script');
        script.src = 'https://www.googletagmanager.com/gtm.js?id=' + encodeURIComponent(id);
        document.head.append(script);
      });
    }

    function stopTags() {
      clearAnalyticsCookies(document, location.hostname);
      if (started) location.reload();
    }

    function apply(next: Choice) {
      choice = next;
      saveChoice(storage, next);
      show(false);
      if (openedFromFooter) toggle.focus({ preventScroll: true });
      openedFromFooter = false;
      if (next === 'accepted') scheduleTags();
      else stopTags();
    }

    function sync() {
      choice = readChoice(storage);
      if (started && choice !== 'accepted') {
        stopTags();
        return;
      }
      show(choice === null);
      if (choice === 'accepted') scheduleTags();
    }

    toggle.hidden = false;
    toggle.addEventListener('click', () => {
      if (!panel.hidden && !preferences.hidden) {
        show(false);
        return;
      }
      openedFromFooter = true;
      show(true);
      showPreferences(true);
      analyticsSwitch.focus();
    });
    preferencesButton.addEventListener('click', () => {
      showPreferences(preferences.hidden);
      if (!preferences.hidden) analyticsSwitch.focus();
    });
    analyticsSwitch.addEventListener('click', () => {
      setSwitch(analyticsSwitch.getAttribute('aria-checked') !== 'true');
    });
    root.querySelector('[data-action="accept"]')!.addEventListener('click', () => apply('accepted'));
    root.querySelectorAll('[data-action="reject"]').forEach(button => {
      button.addEventListener('click', () => apply('declined'));
    });
    root.querySelector('[data-action="save"]')!.addEventListener('click', () => {
      apply(analyticsSwitch.getAttribute('aria-checked') === 'true' ? 'accepted' : 'declined');
    });
    panel.addEventListener('keydown', event => {
      if (event.key !== 'Escape' || choice === null) return;
      show(false);
      toggle.focus({ preventScroll: true });
    });
    window.addEventListener('storage', event => {
      if (event.key === null || event.key === CONSENT_KEY) sync();
    }, { signal });
    window.addEventListener('pageshow', event => { if (event.persisted) sync(); }, { signal });
    document.addEventListener('prerenderingchange', sync, { once: true, signal });
    sync();
  });
</script>

<style>
  a, [data-settings-toggle] { text-decoration: underline; }
  section {
    position: fixed;
    inset: auto 0 0;
    z-index: 80;
    max-height: 85%;
    overflow-y: auto;
    padding: 1rem max(3.5rem, calc((100vw - 1240px) / 2)) max(1rem, env(safe-area-inset-bottom)) max(1.25rem, calc((100vw - 1240px) / 2));
    background: white;
    color: var(--color-ink-900);
    border-top: 1px solid var(--color-line-strong);
    box-shadow: 0 -3px 18px #17264015;
    transition: opacity 420ms var(--ease-out-soft), transform 420ms var(--ease-out-soft);
  }
  section.is-leaving { opacity: 0; transform: translateY(0.75rem); }
  section[data-instant] { transition: none; }
  @starting-style {
    section:not([hidden]) { opacity: 0; transform: translateY(0.75rem); }
  }
  .close {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    color: var(--color-ink-600);
    cursor: pointer;
    transition: background-color var(--duration-fast) var(--ease-out-soft), color var(--duration-fast) var(--ease-out-soft);
  }
  .close:hover { background: var(--color-blue-50); color: var(--color-ink-900); }
  .bar, .choices, .row { display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap; }
  .bar p { flex: 1 1 25rem; margin: 0; }
  .choices button {
    padding: 0.75rem 1.125rem;
    border: 1px solid var(--color-blue-700);
    border-radius: var(--radius-cta);
    font-weight: 500;
    line-height: 1;
    color: var(--color-blue-700);
    cursor: pointer;
    transition:
      background-color var(--duration-ui) var(--ease-ui),
      border-color var(--duration-ui) var(--ease-ui),
      color var(--duration-ui) var(--ease-ui);
  }
  .choices .outline:hover { background: var(--color-blue-50); border-color: var(--color-blue-800); color: var(--color-blue-800); }
  .choices .solid { color: white; background: var(--color-blue-700); }
  .choices .solid:hover { background: var(--color-blue-800); border-color: var(--color-blue-800); }
  .preferences:not([hidden]) { display: grid; gap: 0.75rem; margin-top: 1rem; padding-top: 1rem; border-top: 1px solid var(--color-line-strong); transition: opacity 220ms ease; }
  @starting-style {
    .preferences:not([hidden]) { opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    section, .preferences:not([hidden]) { transition: none; }
  }
  .row { flex-wrap: nowrap; justify-content: space-between; }
  .row span { display: block; }
  [role='switch'] { flex: none; width: 2.75rem; height: 1.5rem; padding: 3px; border-radius: 1rem; background: var(--color-line-strong); }
  .thumb { width: 1.125rem; height: 1.125rem; border-radius: 1rem; background: white; }
  [aria-checked='true'] { background: var(--color-blue-700); }
  [aria-checked='true'] .thumb { margin-left: auto; }
  @media (max-width: 640px), (orientation: landscape) and (height <= 32rem) {
    section {
      padding: 0.75rem 3.25rem max(0.75rem, env(safe-area-inset-bottom)) 1rem;
      font-size: 0.875rem;
    }
    .bar { gap: 0.5rem; }
    .choices { width: 100%; gap: 0.5rem; }
    .choices button {
      flex: 1 1 auto;
      min-height: 2.75rem;
      padding: 0.5rem 0.875rem;
      font-size: 0.875rem;
    }
  }
</style>
