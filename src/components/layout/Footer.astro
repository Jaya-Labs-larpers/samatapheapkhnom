---
import type { Locale } from '~/lib/i18n/config';
import type { SiteSettings } from '~/lib/content/types';
import { localizePath, t } from '~/lib/i18n/utils';
import { footerColumns, legalLinks } from '~/lib/nav';
import LanguageToggle from './LanguageToggle.astro';
import FacebookIcon from '~/components/design/FacebookIcon.astro';
import Logo from '~/components/Logo.astro';
import { text } from '~/lib/i18n/utils';

interface Props {
  lang: Locale;
  settings: SiteSettings;
  pathname: string;
}

const { lang, settings, pathname } = Astro.props;

const facebook = settings.socials?.find((social) => social.platform.toLowerCase() === 'facebook');
const year = new Date().getFullYear();
const orgName = text(settings.orgName, lang);
---

<footer class="ftr">
  <div class="ftr__inner">
    <div class="ftr__grid">
      {
        footerColumns.map((column) => (
          <nav class="ftr__col" aria-label={column.heading}>
            <h2 class="ftr__heading">{column.heading}</h2>
            {column.links.map((link) => (
              <a href={localizePath(link.path, lang)} class="ftr__link">
                {link.label}
              </a>
            ))}
            {column.id === 'connected' && facebook && (
              <div class="ftr__social">
                <a
                  href={facebook.url}
                  class="ftr__social-link"
                  aria-label={t(lang, 'menuFacebookLabel')}
                  rel="noopener"
                >
                  <FacebookIcon size={22} />
                </a>
              </div>
            )}
          </nav>
        ))
      }
    </div>
    <div class="ftr__legal">
      <LanguageToggle lang={lang} pathname={pathname} variant="footer" />
      {legalLinks.map((link) => <a href={localizePath(link.path, lang)} class="ftr__legal-link">{link.label}</a>)}
      <span>© {year} Organization name</span>
      <a href={localizePath('/', lang)} class="ftr__logo">
        <Logo variant="reversed" width={220} title={orgName} lazy />
      </a>
    </div>
  </div>
</footer>

<style>
  .ftr {
    box-sizing: border-box;
    width: 100%;
    background: var(--color-blue-900);
    color: rgb(255 255 255 / 0.72);
    padding: clamp(56px, 6vw, 80px) 20px 32px;
    font-family: var(--font-sans);
  }
  .ftr__inner {
    max-width: 1240px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 64px;
  }
  .ftr__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(180px, 100%), 1fr));
    gap: 40px 32px;
  }
  .ftr__col {
    display: flex;
    flex-direction: column;
    gap: 22px;
  }
  .ftr__heading {
    margin: 0 0 6px;
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    line-height: normal;
    color: #fff;
  }
  .ftr__link {
    color: rgb(255 255 255 / 0.72);
    text-decoration: none;
    font-size: 18px;
  }
  .ftr__link:hover {
    color: #fff;
  }
  .ftr__social {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .ftr__social-link {
    display: inline-flex;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: 1.5px solid var(--color-sky-400);
    color: var(--color-sky-400);
    align-items: center;
    justify-content: center;
  }
  .ftr__address {
    font-style: normal;
    font-size: 16px;
    line-height: 1.6;
  }
  .ftr__legal {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 28px;
    border-top: 1px solid rgb(255 255 255 / 0.15);
    padding-top: 28px;
    font-size: 15px;
    color: rgb(255 255 255 / 0.6);
  }
  .ftr__logo {
    display: block;
    margin-left: auto;
  }
  .ftr__logo :global(img) {
    display: block;
    width: clamp(180px, 18vw, 220px);
    height: auto;
  }
  .ftr__legal-link {
    color: inherit;
    text-decoration: underline;
  }
  :global(:lang(km)) .ftr__heading {
    letter-spacing: normal;
    text-transform: none;
  }
</style>
