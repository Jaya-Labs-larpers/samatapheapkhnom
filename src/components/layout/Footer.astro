---
import type { Locale } from '~/lib/i18n/config';
import type { SiteSettings } from '~/lib/content/types';
import { localizePath, t, text } from '~/lib/i18n/utils';
import { footerColumns } from '~/lib/nav';
import LanguageToggle from './LanguageToggle.astro';
import SocialIcon, { type SocialPlatform } from '~/components/design/SocialIcon.astro';
import Logo from '~/components/Logo.astro';

interface Props {
  lang: Locale;
  settings: SiteSettings;
  pathname: string;
}

const { lang, settings, pathname } = Astro.props;

const socialLabels = {
  facebook: 'menuFacebookLabel',
  telegram: 'menuTelegramLabel',
  instagram: 'menuInstagramLabel',
  youtube: 'menuYoutubeLabel',
} as const;
// Placeholder '#' until SKO adds the real accounts to Site settings in Sanity.
const socials = (Object.keys(socialLabels) as SocialPlatform[]).map((platform) => ({
  platform,
  label: t(lang, socialLabels[platform]),
  url: settings.socials?.find((social) => social.platform.toLowerCase() === platform)?.url ?? '#',
}));
const year = new Date().getFullYear();
const orgName = text(settings.orgName, lang);
const address = text(settings.address, lang);
const { email, phone } = settings;
---

<footer class="ftr">
  <div class="ftr__inner">
    <div class="ftr__top">
      <div class="ftr__brand">
        <a href={localizePath('/', lang)} class="ftr__logo">
          <Logo variant="full" width={200} title={orgName} lazy />
        </a>
      </div>

      <nav class="ftr__nav" aria-label={t(lang, 'footerNavLabel')}>
        {
          footerColumns.map((column) => (
            <div class="ftr__col">
              <h2 class="ftr__heading">{t(lang, column.headingKey)}</h2>
              <ul class="ftr__list">
                {column.links.map((link) => (
                  <li>
                    <a href={localizePath(link.path, lang)} class="ftr__link">
                      {t(lang, link.key)}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }

        <div class="ftr__col">
          <h2 class="ftr__heading">{t(lang, 'footerContactHeading')}</h2>
          <address class="ftr__contact">
            {address && <p class="ftr__address">{address}</p>}
            {
              email && (
                <a href={`mailto:${email}`} class="ftr__link">
                  {email}
                </a>
              )
            }
            {
              phone && (
                <a href={`tel:${phone.replace(/\s+/g, '')}`} class="ftr__link">
                  {phone}
                </a>
              )
            }
          </address>
          <a href={localizePath('/contact', lang)} class="ftr__btn">{t(lang, 'navContact')}</a>
          <ul class="ftr__socials">
            {
              socials.map((social) => (
                <li>
                  <a href={social.url} class="ftr__social" aria-label={social.label} rel="noopener">
                    <SocialIcon platform={social.platform} />
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </nav>
    </div>

    <div class="ftr__legal">
      <span>© {year} {orgName}</span>
      <a href={localizePath('/privacy', lang)} class="ftr__legal-link">{t(lang, 'navPrivacy')}</a>
      <span class="ftr__lang">
        <LanguageToggle lang={lang} pathname={pathname} variant="footer" />
      </span>
    </div>
  </div>
</footer>

<style>
  .ftr {
    box-sizing: border-box;
    width: 100%;
    background: #fff;
    border-top: 1px solid var(--color-line-strong);
    color: var(--color-ink-600);
    padding: clamp(36px, 4vw, 52px) 20px 20px;
    font-family: var(--font-sans);
  }
  .ftr__inner {
    max-width: 1240px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }
  .ftr__top {
    display: grid;
    gap: 32px;
    grid-template-columns: 1fr;
  }
  .ftr__logo {
    display: inline-block;
  }
  .ftr__logo :global(img) {
    display: block;
    width: clamp(150px, 16vw, 200px);
    height: auto;
  }
  .ftr__nav {
    display: grid;
    gap: 28px 32px;
    grid-template-columns: repeat(auto-fit, minmax(min(170px, 100%), 1fr));
  }
  .ftr__col {
    display: flex;
    flex-direction: column;
    gap: 12px;
    min-width: 0;
  }
  .ftr__heading {
    margin: 0;
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    line-height: normal;
    color: var(--color-ink-900);
  }
  .ftr__list {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .ftr__link {
    color: var(--color-ink-600);
    text-decoration: none;
    font-size: 16px;
    line-height: 1.4;
    overflow-wrap: anywhere;
  }
  .ftr__link:hover {
    color: var(--color-ink-900);
  }
  .ftr__contact {
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-style: normal;
  }
  .ftr__address {
    margin: 0;
    font-size: 15px;
    line-height: 1.55;
    white-space: pre-line;
  }
  .ftr__btn {
    align-self: flex-start;
    padding: 10px 22px;
    border-radius: 999px;
    background: var(--color-blue-700);
    color: #fff;
    font-size: 15px;
    font-weight: 600;
    text-decoration: none;
  }
  .ftr__btn:hover {
    background: var(--color-ink-900);
  }
  .ftr__socials {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .ftr__social {
    display: inline-flex;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 1.5px solid var(--color-blue-700);
    color: var(--color-blue-700);
    align-items: center;
    justify-content: center;
  }
  .ftr__social:hover {
    background: var(--color-blue-700);
    color: #fff;
  }
  .ftr__legal {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 24px;
    border-top: 1px solid var(--color-line-strong);
    padding-top: 18px;
    font-size: 14px;
    color: var(--color-ink-600);
  }
  .ftr__legal-link {
    color: inherit;
    text-decoration: underline;
  }
  .ftr__lang {
    margin-left: auto;
  }
  :global(:lang(km)) .ftr__heading {
    letter-spacing: normal;
    text-transform: none;
  }
  @media (min-width: 64rem) {
    .ftr__top {
      grid-template-columns: minmax(180px, 0.7fr) 3fr;
      align-items: start;
      gap: 56px;
    }
  }
</style>
