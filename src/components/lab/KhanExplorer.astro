---
import { khans } from '~/lib/lab/khans';

interface Source {
  kind: string;
  label: string;
  labelLang?: string;
  href: string;
  /** Plain text searched for khan names. */
  text: string;
}

interface Props {
  sources: Source[];
}

const { sources } = Astro.props;

const found = khans.map((khan) => ({
  ...khan,
  items: sources.filter((source) => khan.pattern.test(source.text)),
}));

const rules = [
  ...found.map(
    (khan) => `.kx:has(input[value="${khan.id}"]:checked) [data-khan="${khan.id}"]{display:flex}`,
  ),
  '.kx:has(input:checked) .kx__hint{display:none}',
  '@supports not selector(:has(*)){.kx__panel{display:flex}.kx__hint{display:none}}',
].join('');
---

<div class="kx" lang="en">
  <fieldset class="kx__map">
    <legend class="sr-only">Khans of Phnom Penh</legend>
    {
      found.map((khan) => (
        <label
          class:list={['kx__tile', khan.items.length > 0 && 'kx__tile--found']}
          style={`grid-row:${khan.row};grid-column:${khan.col}`}
        >
          <input class="sr-only" type="radio" name="kx-khan" value={khan.id} />
          <span>{khan.name}</span>
          {khan.items.length > 0 && <span class="kx__count">{khan.items.length}</span>}
        </label>
      ))
    }
  </fieldset>

  <div class="kx__panels">
    <p class="kx__hint sk-small">Choose a khan to see what SKO has published about it.</p>
    {
      found.map((khan) => (
        <section class="kx__panel" data-khan={khan.id} aria-label={khan.name}>
          <h3 class="sk-h3">Khan {khan.name}</h3>
          {khan.items.length > 0 ? (
            <ul class="kx__items">
              {khan.items.map((item) => (
                <li>
                  <span class="sk-pill">{item.kind}</span>
                  <a href={item.href} lang={item.labelLang}>
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          ) : (
            <p class="sk-text">Nothing published mentions this khan yet.</p>
          )}
        </section>
      ))
    }
  </div>
</div>

<style is:inline set:html={rules}></style>

<style>
  .kx {
    display: grid;
    gap: 24px;
    grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 1fr));
    align-items: start;
  }
  .kx__map {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 8px;
    margin: 0;
    padding: 0;
    border: 0;
  }
  .kx__tile {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 72px;
    padding: 8px 6px;
    border: 1px solid var(--color-line);
    border-radius: 12px;
    background: #fff;
    color: var(--color-ink-700);
    font-size: clamp(11px, 0.4vw + 9px, 14px);
    font-weight: 600;
    line-height: 1.25;
    text-align: center;
    cursor: pointer;
  }
  .kx__tile--found {
    background: var(--color-blue-200);
    color: var(--color-ink-900);
  }
  .kx__tile:hover {
    border-color: var(--color-line-strong);
  }
  .kx__tile:has(input:checked) {
    border-color: var(--color-blue-700);
    background: var(--color-blue-700);
    color: #fff;
  }
  .kx__tile:has(input:focus-visible) {
    outline: 2px solid var(--color-blue-700);
    outline-offset: 2px;
  }
  .kx__count {
    position: absolute;
    top: 6px;
    right: 6px;
    min-width: 18px;
    height: 18px;
    padding: 0 5px;
    border-radius: 999px;
    background: var(--color-blue-700);
    color: #fff;
    font-size: 11px;
    line-height: 18px;
  }
  .kx__tile:has(input:checked) .kx__count {
    background: #fff;
    color: var(--color-blue-700);
  }
  .kx__panel {
    display: none;
    flex-direction: column;
    gap: 12px;
    padding: 20px;
    border: 1px solid var(--color-line);
    border-radius: 12px;
    background: #fff;
  }
  .kx__items {
    display: grid;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .kx__items a {
    color: var(--color-blue-800);
  }
</style>
