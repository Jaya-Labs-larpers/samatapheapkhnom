---
import type { Locale } from '~/lib/i18n/config';
import { localizePath } from '~/lib/i18n/utils';
import { siteUrl } from '~/lib/config';
import { quiz } from '~/lib/lab/quiz';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;

const href = (value: string) => (value.startsWith('/') ? localizePath(value, lang) : value);
const shareUrl = new URL(`${localizePath('/lab', lang)}#quiz`, siteUrl).href;
const shareText = 'Do children in Cambodia’s orphanages really have no parents? Take the quiz.';
const share = {
  facebook: `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(shareUrl)}`,
  telegram: `https://t.me/share/url?url=${encodeURIComponent(shareUrl)}&text=${encodeURIComponent(shareText)}`,
};
---

<div class="qz" lang="en">
  {
    quiz.map((question, index) => (
      <fieldset class="qz__q">
        <legend class="sk-h3">
          {index + 1}. {question.question}
        </legend>
        <div class="qz__options">
          {question.options.map((option) => (
            <label class:list={['qz__opt', option.correct && 'qz__opt--right']}>
              <input class="sr-only" type="radio" name={question.id} />
              {option.text}
            </label>
          ))}
        </div>
        <div class="qz__answer">
          <p class="qz__verdict qz__verdict--right">Right.</p>
          <p class="qz__verdict qz__verdict--wrong">Not quite.</p>
          <p class="sk-text">{question.explanation}</p>
          <a class="sk-small" href={href(question.source.href)}>
            Source: {question.source.label}
          </a>
        </div>
      </fieldset>
    ))
  }

  <div class="qz__result">
    <p class="sk-h3">
      Your score: <span class="qz__score"></span> / {quiz.length}
    </p>
    <div class="sk-actions">
      <a class="sk-btn sk-btn--outline" href={share.facebook} target="_blank" rel="noopener">
        Share on Facebook
      </a>
      <a class="sk-btn sk-btn--outline" href={share.telegram} target="_blank" rel="noopener">
        Share on Telegram
      </a>
    </div>
  </div>
</div>

<style>
  .qz {
    display: flex;
    flex-direction: column;
    gap: 20px;
    counter-reset: score;
  }
  .qz__q {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin: 0;
    padding: 20px;
    border: 1px solid var(--color-line);
    border-radius: 12px;
    background: #fff;
  }
  .qz__q legend {
    float: left;
    width: 100%;
    padding: 0;
  }
  .qz__options {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .qz__opt {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 18px;
    border: 1.5px solid var(--color-line-strong);
    border-radius: 999px;
    color: var(--color-ink-700);
    font-weight: 600;
    cursor: pointer;
  }
  .qz__opt:has(input:focus-visible) {
    outline: 2px solid var(--color-blue-700);
    outline-offset: 2px;
  }
  .qz__opt:has(input:checked) {
    border-color: var(--color-danger-700);
    background: var(--color-danger-50);
  }
  .qz__q:has(input:checked) .qz__opt--right {
    border-color: var(--color-success-700);
    background: var(--color-success-50);
    color: var(--color-ink-900);
  }
  .qz__opt--right:has(input:checked) {
    counter-increment: score;
  }
  .qz__answer,
  .qz__verdict {
    display: none;
  }
  .qz__q:has(input:checked) .qz__answer {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .qz__q:has(.qz__opt--right input:checked) .qz__verdict--right,
  .qz__q:has(.qz__opt:not(.qz__opt--right) input:checked) .qz__verdict--wrong {
    display: block;
    margin: 0;
    font-weight: 700;
  }
  .qz__verdict--right {
    color: var(--color-success-700);
  }
  .qz__verdict--wrong {
    color: var(--color-danger-700);
  }
  .qz__score::after {
    content: counter(score);
  }
  .qz__result {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
</style>
