---
/**
 * A programme's results as a bento of hairline-divided tiles. With an odd
 * count the first figure is featured in a double-height tile, so five results
 * make one tall tile and a 2×2 block instead of a row with a gap in it.
 */
import type { Locale } from '~/lib/i18n/config';
import type { ImpactStat } from '~/lib/content/types';
import { countsUp } from '~/lib/content/stats';
import { formatNumber, pick } from '~/lib/i18n/utils';

interface Props {
  lang: Locale;
  stats: ImpactStat[];
}

const { lang, stats } = Astro.props;
const featured = stats.length >= 3 && stats.length % 2 === 1;
const columns = featured ? (stats.length + 1) / 2 : Math.min(stats.length, 4);

/* Glyph widths of the stat font (Inter Bold, tabular figures, -0.03em
   tracking), measured in the browser, so a figure can be sized to its tile. */
const em = (text: string) =>
  Array.from(text).reduce(
    (width, char) =>
      width +
      (/\d/.test(char)
        ? 0.62
        : /[\s,.]/.test(char)
          ? 0.24
          : /[a-z]/i.test(char)
            ? 0.6
            : char === '%'
              ? 1
              : 0.75),
    0,
  );
---

{
  stats.length > 0 && (
    <div
      class:list={['program-stats reveal reveal-cascade', featured && 'program-stats--featured']}
      style={`--cols:${columns};--sm-cols:${Math.min(columns, 2)}`}
    >
      {stats.map((stat, index) => {
        const label = pick(stat.label, lang);
        const context = pick(stat.context, lang);
        const prefix = pick(stat.prefix, lang);
        const suffix = pick(stat.suffix, lang);
        const display =
          stat.displayValue ??
          (typeof stat.value === 'number' ? formatNumber(stat.value, lang) : '');
        const valueEm = Math.max(
          1,
          em(display) +
            (prefix.value ? 0.45 * em(prefix.value) + 0.1 : 0) +
            (suffix.value ? 0.6 * em(suffix.value) : 0),
        );
        return (
          <div class="program-stat" style={`--i:${index};--value-em:${valueEm.toFixed(2)}`}>
            <b class="program-stat__value">
              {prefix.value && (
                <span
                  class="mr-1.5 text-[0.45em] tracking-normal"
                  lang={prefix.isFallback ? prefix.lang : undefined}
                >
                  {prefix.value}
                </span>
              )}
              {countsUp(stat) ? <span data-count-to={stat.value}>{display}</span> : display}
              {suffix.value && <span class="text-[0.6em]">{suffix.value}</span>}
            </b>
            <span class="program-stat__label" lang={label.isFallback ? label.lang : undefined}>
              {label.value}
            </span>
            {context.value && (
              <span
                class="program-stat__context"
                lang={context.isFallback ? context.lang : undefined}
              >
                {context.value}
              </span>
            )}
          </div>
        );
      })}
    </div>
  )
}

<script>
  import { countUpOnEntry } from '~/lib/count-up';
  import { onPageLoad } from '~/lib/page-load';
  onPageLoad(() => countUpOnEntry());
</script>

<style is:global>
@layer components {
  .program-stats {
    display: grid;
    gap: 1px;
    overflow: hidden;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    background: var(--color-line);
  }
  .program-stat {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.75rem 1.5rem;
    background: #fff;
    container-type: inline-size;
  }
  /* A long figure such as "33,910 kg" shrinks to its tile rather than clipping
     at the tile's edge. --value-em is the figure's width in em, estimated by
     ProgramStats from the glyph widths of the stat font. */
  .program-stat__value {
    font-size: min(var(--text-stat), calc(100cqi / var(--value-em, 1)));
    line-height: 1;
    font-weight: 700;
    letter-spacing: var(--text-stat--letter-spacing);
    color: var(--color-blue-700);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .program-stat__label {
    margin-top: 0.5rem;
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.4;
    color: var(--color-ink-900);
  }
  .program-stat__context {
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--color-ink-400);
  }
  @media (min-width: 40rem) {
    .program-stats {
      grid-template-columns: repeat(var(--sm-cols), minmax(0, 1fr));
    }
    .program-stats--featured > :first-child {
      grid-column: span 2;
    }
  }
  @media (min-width: 64rem) {
    .program-stats {
      grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
    }
    .program-stats--featured > :first-child {
      grid-column: auto;
      grid-row: span 2;
      justify-content: flex-end;
      padding: 2.25rem 2rem;
      background: var(--color-blue-900);
    }
    .program-stats--featured > :first-child .program-stat__value {
      font-size: min(calc(var(--text-stat) * 1.6), calc(100cqi / var(--value-em, 1)));
      color: #fff;
    }
    .program-stats--featured > :first-child .program-stat__label {
      font-size: 1.125rem;
      color: #fff;
    }
    .program-stats--featured > :first-child .program-stat__context {
      color: var(--color-sky-200);
    }
  }
}
</style>
