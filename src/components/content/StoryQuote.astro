---
import type { Locale } from '~/lib/i18n/config';
import type { Story } from '~/lib/content/types';
import { localizePath, pick } from '~/lib/i18n/utils';
import { hasImage } from '~/lib/sanity/image';
import ResponsiveImage from '~/components/media/ResponsiveImage.astro';
import RichText from '~/components/content/RichText.astro';

interface Props {
  lang: Locale;
  story: Story;
  /** Show the person's avatar alongside the attribution. */
  showAvatar?: boolean;
  /** Set large, in white, for the navy story band on the home page. */
  inverse?: boolean;
  /** Set a long account at body size rather than lead size. */
  compact?: boolean;
  /** Show the pull quote alone even when the full account exists. */
  quoteOnly?: boolean;
  /** Link the role line to the story's programme page. */
  linkProgram?: boolean;
}

const {
  lang,
  story,
  showAvatar = false,
  inverse = false,
  compact = false,
  quoteOnly = false,
  linkProgram = false,
} = Astro.props;

const quote = pick(story.quote, lang);
const hasBody =
  !quoteOnly &&
  Object.values(story.body ?? {}).some((value) => Array.isArray(value) && value.length > 0);
const role = pick(story.personRole, lang);
const programHref =
  linkProgram && story.program ? localizePath(`/programs/${story.program.slug}`, lang) : null;

/**
 * A photo is only shown when one exists AND staff have not asked for the
 * silhouette. The illustrated avatar is the compliant option for the common
 * case: a real story where no publishable photo exists.
 */
const usePhoto = !story.useSilhouette && hasImage(story.photo);

const quoteClass = inverse
  ? lang === 'km'
    ? 'font-[family-name:var(--font-khmer)] text-[length:var(--text-quote-km)] leading-[1.75] font-semibold'
    : 'font-[family-name:var(--font-display)] text-[length:var(--text-quote)] leading-[1.3] tracking-[-0.02em] font-semibold'
  : lang === 'km'
    ? 'font-[family-name:var(--font-khmer)] text-[17px] sm:text-[22px] leading-[1.8] font-semibold'
    : 'font-[family-name:var(--font-display)] text-[19px] sm:text-[27px] leading-[1.4] font-semibold';
---

<figure class="m-0">
  <div class:list={['rule-accent', inverse && 'bg-[color:var(--color-sky-400)]']}></div>
  {
    hasBody ? (
      <blockquote
        class:list={[
          'mt-4.5',
          compact
            ? 'max-w-[68ch] text-[15px] leading-[1.7] sm:text-[length:var(--text-body)]'
            : 'text-[length:var(--text-body)] leading-[1.65] sm:text-[length:var(--text-lead)] sm:leading-[1.7]',
          inverse && 'text-white',
        ]}
      >
        <RichText blocks={story.body} lang={lang} />
      </blockquote>
    ) : (
      <blockquote
        class:list={[
          'mt-4.5',
          inverse
            ? 'mt-7 max-w-[40ch] text-pretty text-white'
            : 'text-[color:var(--color-ink-900)]',
          quoteClass,
        ]}
        lang={quote.isFallback ? quote.lang : undefined}
      >
        {quote.value}
      </blockquote>
    )
  }

  <figcaption
    class:list={[
      'flex items-center gap-3 text-[15px]',
      inverse ? 'mt-8 text-white/70' : 'mt-4.5 text-[color:var(--color-ink-400)]',
    ]}
  >
    {
      showAvatar &&
        (usePhoto ? (
          <span class="h-11 w-11 flex-none overflow-hidden rounded-full">
            <ResponsiveImage image={story.photo} lang={lang} alt="" aspect="1/1" sizes="44px" />
          </span>
        ) : (
          <span
            class="h-11 w-11 flex-none rounded-full bg-[color:var(--color-aqua-200)]"
            aria-hidden="true"
          />
        ))
    }
    <span>
      — {story.personName}
      {
        role.value && (
          <span lang={role.isFallback ? role.lang : undefined}>
            ,{' '}
            {programHref ? (
              <a
                href={programHref}
                class:list={[
                  'underline underline-offset-4',
                  inverse
                    ? 'decoration-white/40 hover:decoration-white'
                    : 'decoration-current/40 hover:decoration-current',
                ]}
              >
                {role.value}
              </a>
            ) : (
              role.value
            )}
          </span>
        )
      }
    </span>
  </figcaption>
</figure>
