---
import type { Locale } from '~/lib/i18n/config';
import type { DirectorMessage } from '~/lib/content/types';
import { pick } from '~/lib/i18n/utils';
import RichText from './RichText.astro';

interface Props {
  lang: Locale;
  director: DirectorMessage;
}

const { lang, director } = Astro.props;

const name = pick(director.name, lang);
const title = pick(director.title, lang);
const pullQuote = pick(director.pullQuote, lang);

const quoteClass =
  lang === 'km'
    ? 'font-[family-name:var(--font-khmer)] text-[19px] sm:text-[27px] leading-[1.7] font-semibold'
    : 'font-[family-name:var(--font-display)] text-[19px] sm:text-[27px] leading-[1.35] font-semibold tracking-[-0.01em]';
---

<div
  class="reveal relative grid gap-11 overflow-hidden rounded-[var(--radius-xl)] border border-[color:var(--color-line)] bg-white p-7 sm:p-11"
>
  <!-- 4px accent rule, top-left -->
  <span
    class="absolute top-0 left-0 h-1 w-[132px] bg-[color:var(--color-blue-700)]"
    aria-hidden="true"></span>

  <div class="relative pt-1.5">
    <span
      class="pointer-events-none absolute -top-3.5 -left-1.5 font-[family-name:var(--font-display)] text-[52px] leading-none font-bold text-[color:var(--color-aqua-200)] sm:text-[84px]"
      aria-hidden="true">&ldquo;</span
    >

    {
      pullQuote.value && (
        <blockquote
          class:list={['relative m-0 text-[color:var(--color-ink-900)]', quoteClass]}
          lang={pullQuote.isFallback ? pullQuote.lang : undefined}
        >
          {pullQuote.value}
        </blockquote>
      )
    }

    <RichText blocks={director.message} lang={lang} class="mt-5 text-[15.5px] sm:text-[16.5px]" />

    <div class="mt-6.5 border-t border-[color:var(--color-line)] pt-5">
      <b
        class="block text-[16px] text-[color:var(--color-ink-900)]"
        lang={name.isFallback ? name.lang : undefined}>{name.value}</b
      >
      <span
        class="mt-0.5 block text-[14px] text-[color:var(--color-ink-400)]"
        lang={title.isFallback ? title.lang : undefined}>{title.value}</span
      >
    </div>
  </div>
</div>
