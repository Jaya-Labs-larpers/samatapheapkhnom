---
import type { Locale } from '~/lib/i18n/config';
import type { ImpactStat } from '~/lib/content/types';
import { countsUp } from '~/lib/content/stats';
import { formatNumber, pick } from '~/lib/i18n/utils';

interface Props {
  lang: Locale;
  stats: ImpactStat[];
  columns?: 3 | 4;
}

const { lang, stats, columns = 4 } = Astro.props;
// A lead-in ("Nearly") sits on its own line above the figure; when one card
// has it, every card keeps that line so the figures stay level across the row.
const hasPrefix = stats.some((stat) => pick(stat.prefix, lang).value);
---

{
  stats.length > 0 && (
    <div
      class:list={[
        'reveal grid gap-px overflow-hidden rounded-[var(--radius-lg)] border border-[color:var(--color-line)] bg-[color:var(--color-line)]',
        'grid-cols-2',
        columns === 4 ? 'lg:grid-cols-4' : 'lg:grid-cols-3',
      ]}
    >
      {stats.map((stat) => {
        const label = pick(stat.label, lang);
        const context = pick(stat.context, lang);
        const prefix = pick(stat.prefix, lang);
        const suffix = pick(stat.suffix, lang);
        const display =
          stat.displayValue ??
          (typeof stat.value === 'number' ? formatNumber(stat.value, lang) : '');
        return (
          <div class="min-w-0 bg-white px-4 py-5 sm:px-6 sm:py-7">
            {hasPrefix && (
              <span
                class="mb-1.5 block h-6 truncate text-[15px] leading-6 font-semibold text-[color:var(--color-blue-700)]"
                lang={prefix.isFallback ? prefix.lang : undefined}
              >
                {prefix.value}
              </span>
            )}
            <b class="block text-[length:var(--text-stat)] leading-none font-bold tracking-[var(--text-stat--letter-spacing)] text-[color:var(--color-blue-700)] tabular-nums">
              {countsUp(stat) ? (
                <span class="leading-none" data-count-to={stat.value}>
                  {display}
                </span>
              ) : (
                display
              )}
              {suffix.value && <span class="text-[0.6em] leading-none">{suffix.value}</span>}
            </b>
            <span
              class="mt-2.5 block text-[14px] leading-[1.35] font-semibold text-[color:var(--color-ink-900)] sm:mt-3 sm:text-[15px]"
              lang={label.isFallback ? label.lang : undefined}
            >
              {label.value}
            </span>
            {context.value && (
              <span
                class="mt-1.5 hidden text-[13px] leading-[1.5] text-[color:var(--color-ink-400)] sm:block"
                lang={context.isFallback ? context.lang : undefined}
              >
                {context.value}
              </span>
            )}
          </div>
        );
      })}
    </div>
  )
}

<script>
  import { countUpOnEntry } from '~/lib/count-up';
  countUpOnEntry();
</script>
