---
/**
 * A CMS body laid out section by section (About and every programme page).
 * The text is exactly what staff typed into the body in Sanity;
 * ~/lib/content/sections only decides where each "## " section breaks and
 * which layout its shape suits. A Khmer body gets the same layouts; until one
 * exists the English falls back with lang="en" on every section.
 */
import type { Locale } from '~/lib/i18n/config';
import type { LocaleBlocks, Partner } from '~/lib/content/types';
import { pick } from '~/lib/i18n/utils';
import { hasImage } from '~/lib/sanity/image';
import {
  TERM_LIMITS,
  blockText,
  blockAfterLeadIn,
  hasLinkMarks,
  splitBody,
  splitLeadIn,
  splitPoint,
  type TermLimits,
} from '~/lib/content/sections';
import { renderSpans } from '~/lib/portable-text';
import RichText from './RichText.astro';
import ResponsiveImage from '~/components/media/ResponsiveImage.astro';

interface Props {
  lang: Locale;
  body?: LocaleBlocks | null;
  limits?: TermLimits;
  /** Partners whose name a statement mentions get their logo set beneath it. */
  partners?: Partner[];
  /** Set the opening paragraph of running prose as a lead. */
  leadProse?: boolean;
  /** Show only these h2 sections (by position). The lead rides with section 0. */
  only?: number[];
  /** Force the lead on or off; by default it shows with the whole body or with section 0. */
  showLead?: boolean;
}

const {
  lang,
  body,
  limits = TERM_LIMITS,
  partners = [],
  leadProse = false,
  only,
  showLead,
} = Astro.props;

const picked = pick(body, lang);
const bodyLang = picked.lang;
const fallbackLang = picked.isFallback ? bodyLang : undefined;
const split = splitBody(picked.value, limits);
const lead = (showLead ?? (!only || only.includes(0))) ? split.lead : [];
const sections = only
  ? only.flatMap((position) => (split.sections[position] ? [split.sections[position]] : []))
  : split.sections;

/** RichText picks by locale, so each slice goes back in under the body's own language. */
const asBlocks = (blocks: typeof lead): LocaleBlocks => ({
  [bodyLang]: blocks,
});

/** A row's running text, keeping any link the row carries. */
const restHtml = (block: (typeof lead)[number], rest: string) => {
  const after = hasLinkMarks(block) ? blockAfterLeadIn(block, rest) : null;
  return after ? renderSpans(after) : null;
};

/** "UNOPS / Cities Alliance" is credited when either half is named. */
function mentioned(text: string): Partner[] {
  const haystack = text.toLowerCase();
  return partners.filter((partner) =>
    partner.name
      .split('/')
      .map((part) => part.trim().toLowerCase())
      .some((part) => part.length >= 4 && haystack.includes(part)),
  );
}
---

{
  lead.length > 0 && (
    <section class="section pb-0">
      <div class="wrap">
        <RichText blocks={asBlocks(lead)} lang={lang} class="about-lead" />
      </div>
    </section>
  )
}

{
  sections.map((section) => {
    const logos =
      section.layout === 'statement' ? mentioned(section.blocks.map(blockText).join(' ')) : [];
    return (
      <section
        class:list={['about-section', `about-section--${section.layout}`]}
        lang={fallbackLang}
      >
        <div class="wrap about-section__grid">
          <h2
            class:list={['about-section__label eyebrow', section.layout === 'points' && 'reveal']}
          >
            {section.heading}
          </h2>

          {section.layout === 'statement' && (
            <div>
              <RichText blocks={asBlocks(section.blocks)} lang={lang} class="about-statement" />
              {logos.length > 0 && (
                <ul class="statement-logos reveal reveal-cascade list-none p-0">
                  {logos.map((partner, index) => (
                    <li class="statement-logo [&_img]:object-contain" style={`--i:${index}`}>
                      {hasImage(partner.logo) ? (
                        <ResponsiveImage
                          image={partner.logo}
                          lang={lang}
                          alt={partner.name}
                          aspect="5/3"
                          sizes="160px"
                          blurUp={false}
                        />
                      ) : (
                        <span>{partner.name}</span>
                      )}
                    </li>
                  ))}
                </ul>
              )}
            </div>
          )}

          {section.layout === 'terms' && (
            <ol class="about-terms reveal reveal-cascade list-none p-0">
              {section.blocks.map((block, index) => {
                const split = splitLeadIn(blockText(block), limits)!;
                const html = restHtml(block, split.rest);
                return (
                  <li class="about-term" style={`--i:${index}`}>
                    <span class="about-term__index" aria-hidden="true">
                      {String(index + 1).padStart(2, '0')}
                    </span>
                    <span class="about-term__name">{split.term}</span>
                    {html ? (
                      <span class="about-term__text" set:html={html} />
                    ) : (
                      <span class="about-term__text">{split.rest}</span>
                    )}
                  </li>
                );
              })}
            </ol>
          )}

          {section.layout === 'points' && (
            <ol
              class="about-terms reveal reveal-cascade reveal-cascade--slow list-none p-0"
              data-reveal-ms="2400"
            >
              {section.blocks.map((block, index) => {
                const split = splitPoint(blockText(block))!;
                const html = restHtml(block, split.rest);
                return (
                  <li class="about-term" style={`--i:${index}`}>
                    <span class="about-term__index" aria-hidden="true">
                      {String(index + 1).padStart(2, '0')}
                    </span>
                    <span class="about-term__name">{split.term}</span>
                    {html ? (
                      <span class="about-term__text" set:html={html} />
                    ) : (
                      <span class="about-term__text">{split.rest}</span>
                    )}
                  </li>
                );
              })}
            </ol>
          )}

          {section.layout === 'facts' && (
            <RichText blocks={asBlocks(section.blocks)} lang={lang} class="about-facts" />
          )}

          {section.layout === 'prose' && (
            <RichText
              blocks={asBlocks(section.blocks)}
              lang={lang}
              class={leadProse ? 'about-prose about-prose--lead' : 'about-prose'}
            />
          )}
        </div>
      </section>
    );
  })
}

<style is:global>
@layer components {
  /* --- About page body (SectionedBody) ---------------------------------- *
   * Each "## " section of the CMS body gets a label column and a content
   * column, divided by a hairline. The label sticks beside long prose so the
   * visitor always knows which part they are reading. */
  .about-lead {
    font-size: var(--text-lead);
    line-height: 1.7;
    color: var(--color-ink-900);
  }
  .about-section {
    padding-top: clamp(2.5rem, 2rem + 3vw, 5rem);
  }
  .about-section__grid {
    display: grid;
    gap: 1rem;
    padding-top: clamp(1.5rem, 1rem + 1.5vw, 2.5rem);
    border-top: 1px solid var(--color-line);
  }
  @media (min-width: 64rem) {
    .about-section__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 2.6fr);
      gap: 3rem;
    }
    .about-section--prose .about-section__label {
      position: sticky;
      top: calc(var(--header-offset) + 1.5rem);
      align-self: start;
      transition: top 320ms var(--ease-out-soft);
    }
  }
  .about-section__label {
    padding-top: 0.4rem;
  }

  .prose.about-statement p {
    max-width: 30ch;
    font-size: var(--text-statement);
    line-height: 1.3;
    letter-spacing: -0.02em;
    color: var(--color-ink-900);
    text-align: start;
    hyphens: manual;
  }
  .prose.about-statement:lang(km) p {
    max-width: 36ch;
    line-height: 1.6;
    letter-spacing: normal;
  }

  .about-terms {
    border-top: 1px solid var(--color-line);
  }
  .about-term {
    display: grid;
    grid-template-columns: 2.75rem minmax(0, 1fr);
    gap: 0.25rem 1rem;
    padding: 1.25rem 0.75rem;
    border-bottom: 1px solid var(--color-line);
    transition: background-color var(--duration-base) var(--ease-out-soft);
  }
  .about-term__index {
    grid-row: span 2;
    padding-top: 0.3rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--color-blue-700);
  }
  .about-term__name {
    font-size: clamp(1.125rem, 0.95rem + 1vw, 1.625rem);
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.015em;
    color: var(--color-ink-900);
  }
  .about-term__text {
    max-width: 60ch;
    font-size: 0.9688rem;
    line-height: 1.6;
    color: var(--color-ink-600);
  }
  @media (min-width: 48rem) {
    .about-term {
      grid-template-columns: 3.5rem minmax(12rem, 1fr) minmax(0, 1.8fr);
      align-items: baseline;
      gap: 1.5rem;
    }
    .about-term__index {
      grid-row: auto;
    }
  }
  @media (hover: hover) and (pointer: fine) {
    .about-term:hover {
      background: var(--color-blue-50);
    }
  }

  .about-facts ul {
    padding-left: 0;
    list-style: none;
    border-top: 1px solid var(--color-line);
  }
  .about-facts li {
    margin: 0;
    padding-block: 1.125rem;
    border-bottom: 1px solid var(--color-line);
    font-size: clamp(1rem, 0.85rem + 0.9vw, 1.5rem);
    line-height: 1.4;
    color: var(--color-ink-900);
    text-align: start;
  }
  .prose.about-facts li + li {
    margin-top: 0;
  }

  .about-prose--lead > p:first-child {
    font-size: var(--text-lead);
    line-height: 1.65;
    color: var(--color-ink-900);
  }

  .statement-logos {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }
  .statement-logo {
    display: grid;
    place-items: center;
    width: 10rem;
    aspect-ratio: 5 / 3;
    padding: 0.875rem;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    background: #fff;
    font-size: 0.8125rem;
    font-weight: 600;
    line-height: 1.3;
    text-align: center;
    color: var(--color-ink-600);
  }
  .statement-logo img {
    max-height: 100%;
  }
}
</style>
