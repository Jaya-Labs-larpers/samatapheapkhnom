---
import type { Locale } from '~/lib/i18n/config';
import { localizePath, parsePath, t } from '~/lib/i18n/utils';
import type { UIKey } from '~/lib/i18n/strings';

interface Props {
  lang: Locale;
  pathname: string;
  items: { key: UIKey; path: string }[];
}

const { lang, pathname, items } = Astro.props;
const current = parsePath(pathname).path.replace(/\/$/, '') || '/';
---

<nav class="subnav" aria-label={t(lang, 'inThisSection')}>
  <ul>
    {
      items.map((item) => (
        <li>
          <a
            href={localizePath(item.path, lang)}
            class="subnav__link"
            aria-current={current === item.path ? 'page' : undefined}
          >
            {t(lang, item.key)}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .subnav {
    border-bottom: 1px solid var(--color-line);
    background: #fff;
  }
  .subnav ul {
    display: flex;
    gap: 8px;
    max-width: 1240px;
    margin: 0 auto;
    padding: 12px 20px;
    list-style: none;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .subnav__link {
    display: block;
    padding: 9px 18px;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    color: var(--color-ink-900);
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    transition:
      background-color 0.2s ease,
      border-color 0.2s ease,
      color 0.2s ease;
  }
  .subnav__link:is(:hover, :focus-visible) {
    background: var(--color-blue-50);
    border-color: var(--color-blue-700);
  }
  .subnav__link[aria-current='page'] {
    background: var(--color-blue-700);
    border-color: var(--color-blue-700);
    color: #fff;
  }
</style>
