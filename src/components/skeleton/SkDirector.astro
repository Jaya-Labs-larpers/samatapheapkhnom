---
import type { Locale } from '~/lib/i18n/config';
import type { DirectorMessage } from '~/lib/content/types';
import { langAttr, pick } from '~/lib/i18n/utils';
import { hasImage, imageDimensions } from '~/lib/sanity/image';
import ResponsiveImage from '~/components/media/ResponsiveImage.astro';

interface Props {
  lang: Locale;
  director: DirectorMessage;
  heading: string;
  link: { label: string; href: string };
}

const { lang, director, heading, link } = Astro.props;
const quote = pick(director.pullQuote, lang);
const name = pick(director.name, lang);
const role = pick(director.title, lang);
const photo = director.photo && hasImage(director.photo) ? director.photo : null;
const { width, height } = imageDimensions(photo);
---

{
  quote.value && (
    <section
      class:list={['sk-director', photo && 'sk-director--with-photo']}
      aria-labelledby="home-director-heading"
      style={photo ? `--portrait-ratio: ${width / height}` : undefined}
    >
      {photo && (
        <div class="sk-director__photo">
          <div class="sk-director__portrait clip-reveal">
            <ResponsiveImage
              image={photo}
              lang={lang}
              alt=""
              keep
              sizes="(min-width: 48rem) 50vw, 100vw"
            />
          </div>
        </div>
      )}
      <div class="sk-director__body">
        <h2 id="home-director-heading">{heading}</h2>
        <figure class="sk-figure">
          <blockquote class="sk-quote sk-director__quote" lang={langAttr(quote)}>
            “{quote.value}”
          </blockquote>
          <figcaption class="sk-person">
            <b lang={langAttr(name)}>{name.value}</b>
            <span class="sk-small" lang={langAttr(role)}>
              {role.value}
            </span>
          </figcaption>
        </figure>
        <a href={link.href} class="sk-link">
          {link.label} →
        </a>
      </div>
    </section>
  )
}

<style>
  .sk-director {
    --portrait-gutter: clamp(16px, 2.5vw, 40px);
    display: grid;
    background: var(--color-surface-subtle);
    color: var(--color-ink-900);
  }

  .sk-director__photo {
    position: relative;
    min-height: 0;
    margin-inline: var(--portrait-gutter);
  }

  .sk-director__portrait {
    position: relative;
    aspect-ratio: var(--portrait-ratio);
    overflow: hidden;
    background: var(--color-surface-sunken);
  }

  .sk-director__portrait :global(.blur-up) {
    position: absolute;
    inset: 0;
  }

  .sk-director__body {
    display: grid;
    align-content: center;
    justify-items: start;
    gap: clamp(18px, 2.25vw, 32px);
    width: min(100%, 48rem);
    margin-inline: auto;
    padding: clamp(36px, 5vw, 80px) clamp(24px, 5vw, 96px);
  }

  .sk-director__body h2 {
    margin: 0;
    color: var(--color-ink-600);
    font-size: 1rem;
    font-weight: 600;
  }

  .sk-director__body figure {
    gap: clamp(18px, 2vw, 28px);
  }

  .sk-director__quote {
    font-size: clamp(1.5rem, 0.9rem + 1.55vw, 2.25rem);
    line-height: 1.25;
    letter-spacing: -0.025em;
    text-wrap: pretty;
  }

  .sk-director__quote:lang(km) {
    line-height: 1.55;
    letter-spacing: normal;
  }

  @media (max-width: 47.99rem) {
    .sk-director--with-photo {
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    }

    .sk-director--with-photo .sk-director__photo {
      margin-block: 16px;
      margin-inline: 16px 0;
      border-radius: 12px;
      overflow: hidden;
    }

    .sk-director--with-photo .sk-director__portrait {
      position: absolute;
      inset: 0;
      aspect-ratio: auto;
    }

    .sk-director--with-photo .sk-director__portrait :global(img) {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .sk-director--with-photo .sk-director__body {
      gap: 14px;
      padding: 20px 16px 20px 18px;
    }

    .sk-director--with-photo .sk-director__quote {
      font-size: clamp(1.0625rem, 0.6rem + 2.4vw, 1.3rem);
      line-height: 1.3;
    }

    .sk-director--with-photo .sk-person b {
      font-size: 0.9375rem;
    }

    .sk-director--with-photo .sk-person .sk-small {
      font-size: 13px;
    }
  }

  @media (min-width: 48rem) {
    .sk-director--with-photo {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      min-height: min(
        calc(100svh - var(--header-h)),
        calc((50vw - 2 * var(--portrait-gutter)) / var(--portrait-ratio))
      );
    }

    .sk-director__portrait {
      position: absolute;
      inset: 0;
      width: auto;
      max-width: 100%;
      height: 100%;
      margin-inline: auto;
    }
  }
</style>
