---
import type { Locale } from '~/lib/i18n/config';
import type { CmsImage } from '~/lib/content/types';
import type { SkAction } from '~/lib/skeleton-content';
import ResponsiveImage from '~/components/media/ResponsiveImage.astro';

interface Props {
  lang: Locale;
  heading: string;
  body?: string | null;
  actions: SkAction[];
  image?: CmsImage | null;
  card?: boolean;
  keep?: boolean;
}

const { lang, heading, body, actions, image, card = false, keep = false } = Astro.props;
const tile = card ? actions[0] : undefined;
const buttons = tile ? actions.slice(1) : actions;
---

<section class:list={['sk-cta-split', card && 'sk-cta-split--card']}>
  {
    image && (
      <div class="sk-cta-split__media clip-reveal">
        <ResponsiveImage
          image={image}
          lang={lang}
          alt=""
          aspect="4/3"
          keep={keep}
          sizes="(min-width: 64rem) 50vw, 100vw"
        />
      </div>
    )
  }
  <div class="sk-cta-split__panel">
    <div class="sk-cta-split__copy">
      <h2 class="sk-h2">{heading}</h2>
      {body && <p class="sk-lead">{body}</p>}
      {
        buttons.length > 0 && (
          <div class="sk-actions">
            {buttons.map((action) => (
              <a
                href={action.href}
                class:list={[
                  'sk-btn',
                  tile || action !== actions[0] ? 'sk-btn--ghost' : 'sk-btn--light',
                ]}
              >
                {action.label}
              </a>
            ))}
          </div>
        )
      }
    </div>
    {
      tile && (
        <a href={tile.href} class="btn-tile sk-cta-split__tile clip-reveal" data-reveal-delay="300">
          <span>{tile.label}</span>
          <svg
            class="btn-tile__arrow"
            viewBox="0 0 42 38"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M3 19h36M22 3l17 16-17 16" />
          </svg>
        </a>
      )
    }
  </div>
</section>

<style is:global>
  .sk-cta-split--card {
    position: relative;
    isolation: isolate;
    display: block;
    box-sizing: border-box;
    width: min(100% - 40px, 1281px);
    min-height: 0;
    margin: clamp(32px, 5vw, 72px) auto;
    border-radius: 24px;
    overflow: hidden;
    background: var(--color-ink-900);
  }
  .sk-cta-split--card .sk-cta-split__media {
    position: absolute;
    inset: 0;
    z-index: -1;
    min-height: 0;
  }
  .sk-cta-split--card .sk-cta-split__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgb(14 21 51 / 0.55);
  }
  .sk-cta-split--card .sk-cta-split__panel {
    align-items: flex-start;
    padding: clamp(40px, 6vw, 80px) clamp(24px, 5vw, 72px);
  }
  .sk-cta-split--card .sk-h2 {
    max-width: 22ch;
  }
  .sk-cta-split__copy {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .sk-cta-split--card .sk-cta-split__panel {
    display: grid;
    gap: clamp(24px, 4vw, 48px);
  }
  .sk-cta-split__tile {
    align-self: end;
  }
  @media (min-width: 64rem) {
    .sk-cta-split--card .sk-cta-split__panel {
      grid-template-columns: minmax(0, 1fr) minmax(18rem, 24rem);
      align-items: end;
    }
  }
</style>
