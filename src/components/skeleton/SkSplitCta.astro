---
import type { Locale } from '~/lib/i18n/config';
import type { CmsImage } from '~/lib/content/types';
import type { SkAction } from '~/lib/skeleton-content';
import ResponsiveImage from '~/components/media/ResponsiveImage.astro';

interface Props {
  lang: Locale;
  heading: string;
  body?: string | null;
  actions: SkAction[];
  image?: CmsImage | null;
  card?: boolean;
  keep?: boolean;
}

const { lang, heading, body, actions, image, card = false, keep = false } = Astro.props;
---

<section class:list={['sk-cta-split', card && 'sk-cta-split--card']}>
  {
    image && (
      <div class="sk-cta-split__media clip-reveal">
        <ResponsiveImage
          image={image}
          lang={lang}
          alt=""
          aspect="4/3"
          keep={keep}
          sizes="(min-width: 64rem) 50vw, 100vw"
        />
      </div>
    )
  }
  <div class="sk-cta-split__panel">
    <div class="sk-cta-split__copy">
      <h2 class="sk-h2">{heading}</h2>
      {body && <p class="sk-lead">{body}</p>}
      {
        actions.length > 0 && (
          <div class="sk-actions">
            {actions.map((action, index) => (
              <a
                href={action.href}
                class:list={['sk-btn', index === 0 ? 'sk-btn--light' : 'sk-btn--ghost']}
              >
                {action.label}
              </a>
            ))}
          </div>
        )
      }
    </div>
  </div>
</section>

<style is:global>
  .sk-cta-split--card {
    position: relative;
    isolation: isolate;
    display: block;
    box-sizing: border-box;
    width: min(100% - 40px, 1281px);
    min-height: 0;
    margin: clamp(32px, 5vw, 72px) auto;
    border-radius: 24px;
    overflow: hidden;
    background: var(--color-ink-900);
  }
  .sk-cta-split--card .sk-cta-split__media {
    position: absolute;
    inset: 0;
    z-index: -1;
    min-height: 0;
  }
  .sk-cta-split--card .sk-cta-split__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgb(14 21 51 / 0.55);
  }
  .sk-cta-split--card .sk-cta-split__panel {
    align-items: flex-start;
    padding: clamp(40px, 6vw, 80px) clamp(24px, 5vw, 72px);
  }
  .sk-cta-split--card .sk-h2 {
    max-width: 22ch;
  }
  .sk-cta-split__copy {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  /* Equal columns, so every button is as wide as the others. */
  .sk-cta-split--card .sk-actions {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(10.5rem, 1fr));
    width: min(100%, 24rem);
  }
</style>
