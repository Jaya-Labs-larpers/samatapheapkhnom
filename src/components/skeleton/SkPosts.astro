---
import type { Locale } from '~/lib/i18n/config';
import type { SkAction, SkPostItem } from '~/lib/skeleton-content';
import ResponsiveImage from '~/components/media/ResponsiveImage.astro';
import SkSection from './SkSection.astro';
import SkLines from './SkLines.astro';

interface Props {
  heading: string;
  /** Slots the design shows; real posts fill the first ones, grey cards the rest. */
  n?: number;
  link?: string;
  lang?: Locale;
  readMore?: string;
  items?: SkPostItem[];
  more?: SkAction | null;
  tone?: 'default' | 'tint';
  moreInHeader?: boolean;
}

const {
  heading,
  n = 3,
  link,
  lang = 'en',
  readMore,
  items = [],
  more,
  tone = 'default',
  moreInHeader = false,
} = Astro.props;
const placeholders = Math.max(0, n - items.length);
---

<SkSection tone={tone}>
  <div class:list={[moreInHeader && 'posts-head']}>
    <h2 class="sk-h2">{heading}</h2>
    {
      moreInHeader && more && (
        <a class="sk-link" href={more.href}>
          {more.label} →
        </a>
      )
    }
  </div>
  <div class:list={['sk-grid', items.length >= 3 && 'sk-grid--mosaic']}>
    {
      items.map((item) => (
        <article class="sk-card">
          {Boolean(item.image) && (
            <div class="sk-media sk-card__media clip-reveal" style="aspect-ratio:3/2">
              <ResponsiveImage
                image={item.image}
                lang={lang}
                alt=""
                aspect="3/2"
                sizes="(min-width: 64rem) 380px, (min-width: 40rem) 50vw, 100vw"
              />
            </div>
          )}
          {item.category && (
            <div>
              <span class="sk-pill">{item.category}</span>
            </div>
          )}
          <h3 class="sk-h3" lang={item.titleLang}>
            <a href={item.href} class="sk-stretch">
              {item.title}
            </a>
          </h3>
          <p class="sk-small">
            <time datetime={item.datetime}>{item.date}</time>
            {item.author && <span> {item.author}</span>}
          </p>
          {item.excerpt && (
            <p class="sk-text" lang={item.excerptLang}>
              {item.excerpt}
            </p>
          )}
          {readMore && <span class="sk-link">{readMore} →</span>}
        </article>
      ))
    }
    {
      Array.from({ length: placeholders }, (_, i) => (
        <a
          href={`/blog/post-${((items.length + i) % 6) + 1}`}
          class="sk-card"
          style="text-decoration:none"
        >
          <div class="sk-meta">
            <div class="sk-bar" />
            <div class="sk-bar" />
          </div>
          <h3 class="sk-h3">Post title {items.length + i + 1}</h3>
          <SkLines n={3} />
        </a>
      ))
    }
  </div>
  {
    more
      ? !moreInHeader && (
          <div class="posts-more">
            <a href={more.href} class="sk-btn">
              {more.label}
            </a>
          </div>
        )
      : link && (
          <a href="/blog" class="sk-link">
            {link} →
          </a>
        )
  }
</SkSection>

<style>
  .posts-head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 16px 32px;
  }
  .posts-more {
    display: flex;
    justify-content: center;
    margin-top: clamp(24px, 3vw, 36px);
  }
</style>
