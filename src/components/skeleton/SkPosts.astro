---
import type { Locale } from '~/lib/i18n/config';
import type { SkAction, SkPostItem } from '~/lib/skeleton-content';
import ResponsiveImage from '~/components/media/ResponsiveImage.astro';
import SkSection from './SkSection.astro';
import SkLines from './SkLines.astro';

interface Props {
  heading: string;
  /** Slots the design shows; real posts fill the first ones, grey cards the rest. */
  n?: number;
  link?: string;
  lang?: Locale;
  readMore?: string;
  items?: SkPostItem[];
  more?: SkAction | null;
  keep?: boolean;
}

const { heading, n = 3, link, lang = 'en', readMore, items = [], more, keep = false } = Astro.props;
const placeholders = Math.max(0, n - items.length);
---

<SkSection>
  <h2 class="sk-h2">{heading}</h2>
  <div class:list={['sk-grid', items.length >= 3 && 'sk-grid--mosaic']}>
    {
      items.map((item) => (
        <article class="sk-card">
          {(keep ? Boolean(item.image) : item.image !== undefined) && (
            <div class="sk-media sk-card__media clip-reveal" style="aspect-ratio:3/2">
              <ResponsiveImage
                image={item.image}
                lang={lang}
                alt=""
                aspect="3/2"
                keep={keep}
                sizes="(min-width: 64rem) 380px, (min-width: 40rem) 50vw, 100vw"
              />
            </div>
          )}
          <p class="sk-small">
            {item.category && <span class="sk-pill">{item.category}</span>}
            <time datetime={item.datetime}>{item.date}</time>
            {item.author && <span> · {item.author}</span>}
          </p>
          <h3 class="sk-h3" lang={item.titleLang}>
            <a href={item.href} class="sk-stretch">
              {item.title}
            </a>
          </h3>
          {item.excerpt && (
            <p class="sk-text sk-clamp" lang={item.excerptLang}>
              {item.excerpt}
            </p>
          )}
          {readMore && <span class="sk-link">{readMore} →</span>}
        </article>
      ))
    }
    {
      Array.from({ length: placeholders }, (_, i) => (
        <a
          href={`/blog/post-${((items.length + i) % 6) + 1}`}
          class="sk-card"
          style="text-decoration:none"
        >
          <div class="sk-meta">
            <div class="sk-bar" />
            <div class="sk-bar" />
          </div>
          <h3 class="sk-h3">Post title {items.length + i + 1}</h3>
          <SkLines n={3} />
        </a>
      ))
    }
  </div>
  {
    more ? (
      <div class="posts-more">
        <a href={more.href} class="posts-more__btn">
          {more.label}
        </a>
      </div>
    ) : (
      link && (
        <a href="/blog" class="sk-link">
          {link} →
        </a>
      )
    )
  }
</SkSection>

<style>
  .posts-more {
    display: flex;
    justify-content: center;
    margin-top: clamp(28px, 4vw, 44px);
  }
  .posts-more__btn {
    padding: clamp(1rem, 1.6vw, 1.25rem) clamp(1.5rem, 3vw, 2.25rem);
    border-radius: var(--radius-cta);
    background: var(--color-blue-700);
    color: #fff;
    font-size: clamp(0.9375rem, 0.675rem + 1.2vw, 1.5rem);
    font-weight: 500;
    line-height: 1;
    text-decoration: none;
    transition: background-color var(--duration-ui) var(--ease-ui);
  }
  .posts-more__btn:is(:hover, :focus-visible) {
    background: var(--color-blue-800);
  }
</style>
