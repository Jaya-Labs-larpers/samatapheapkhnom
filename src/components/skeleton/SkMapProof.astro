---
import type { Locale } from '~/lib/i18n/config';
import type { ImpactStat } from '~/lib/content/types';
import { countsUp } from '~/lib/content/stats';
import { formatNumber, pick } from '~/lib/i18n/utils';
import ImpactStats from '~/components/content/ImpactStats.astro';
import SkSection from './SkSection.astro';

interface Props {
  lang: Locale;
  stats: ImpactStat[];
}

const { lang, stats } = Astro.props;
const [lead, ...rest] = stats;
const label = lead ? pick(lead.label, lang) : null;
const prefix = lead ? pick(lead.prefix, lang) : null;
const suffix = lead ? pick(lead.suffix, lang) : null;
const display = lead
  ? (lead.displayValue ?? (typeof lead.value === 'number' ? formatNumber(lead.value, lang) : ''))
  : '';
---

{
  lead && (
    <SkSection class="sk-proof">
      <div class="proof reveal" data-reveal-ms="1300">
        <div class="proof__lead">
          {prefix?.value && (
            <span class="proof__prefix" lang={prefix.isFallback ? prefix.lang : undefined}>
              {prefix.value}
            </span>
          )}
          <b class="proof__figure">
            {countsUp(lead) ? <span data-count-to={lead.value}>{display}</span> : display}
            {suffix?.value && <span class="proof__suffix">{suffix.value}</span>}
          </b>
          {label?.value && (
            <span class="proof__label" lang={label.isFallback ? label.lang : undefined}>
              {label.value}
            </span>
          )}
        </div>
        <img
          class="proof__map"
          src="/maps/cambodia-phnom-penh.svg"
          alt=""
          width="1000"
          height="896"
          loading="lazy"
          decoding="async"
        />
      </div>
      <div class:list={['proof__stats', rest.length === 3 && 'proof__stats--row']}>
        <ImpactStats lang={lang} stats={rest} columns={rest.length > 3 ? 4 : 3} />
      </div>
    </SkSection>
  )
}

<style>
  .proof {
    display: grid;
    gap: clamp(24px, 4vw, 56px);
    align-items: center;
  }
  .proof__lead {
    display: flex;
    flex-direction: column;
    gap: 12px;
    min-width: 0;
  }
  .proof__prefix {
    font-size: 17px;
    font-weight: 600;
    color: var(--color-blue-700);
  }
  .proof__figure {
    display: block;
    font-family: var(--font-display);
    font-size: clamp(3.5rem, 1rem + 9vw, 8rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.045em;
    color: var(--color-ink-900);
    font-variant-numeric: tabular-nums;
  }
  .proof__suffix {
    font-size: 0.5em;
  }
  .proof__label {
    max-width: 24ch;
    font-size: clamp(1.125rem, 1rem + 0.6vw, 1.5rem);
    line-height: 1.3;
    color: var(--color-ink-900);
  }
  .proof__map {
    display: block;
    width: min(100%, 520px);
    height: auto;
    justify-self: center;
  }
  :global(:lang(km)) .proof__figure {
    letter-spacing: normal;
  }
  @media (max-width: 63.99rem) {
    .proof {
      gap: 20px;
    }
    .proof__lead {
      gap: 6px;
    }
    .proof__figure {
      font-size: clamp(3rem, 1rem + 10vw, 4.5rem);
    }
    .proof__label {
      max-width: none;
      font-size: clamp(1rem, 0.5rem + 3.2vw, 1.25rem);
    }
    .proof__map {
      width: min(86%, 420px);
    }
  }
  @media (max-width: 63.99rem) {
    .proof__stats--row :global(.grid) {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      column-gap: 12px;
    }
    .proof__stats--row :global(b) {
      font-size: clamp(1.75rem, 0.6rem + 6vw, 3rem);
    }
    .proof__stats--row :global(b + span) {
      font-size: 13px;
    }
  }
  @media (min-width: 64rem) {
    .proof {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .proof {
      --reveal-rise: 14px;
    }
    .proof[data-reveal='pending'] {
      translate: 0 14px;
    }
    .proof[data-reveal='shown'] {
      transition:
        opacity 1200ms var(--ease-reveal) var(--reveal-delay, 0ms),
        translate 1200ms var(--ease-reveal) var(--reveal-delay, 0ms);
    }
    .proof__map {
      transition:
        opacity 1400ms ease-out 150ms,
        scale 1400ms var(--ease-reveal) 150ms;
    }
    :global(.reveal[data-reveal='pending']) .proof__map {
      opacity: 0;
      scale: 0.97;
    }
  }
</style>
