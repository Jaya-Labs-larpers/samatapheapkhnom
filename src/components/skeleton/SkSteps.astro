---
import SkSection from './SkSection.astro';
import SkLines from './SkLines.astro';

interface Props {
  heading: string;
  n?: number;
}

const { heading, n = 4 } = Astro.props;
---

<SkSection tone="tint">
  <h2 class="sk-h2">{heading}</h2>
  <div class="sk-grid">
    {
      Array.from({ length: n }, (_, i) => (
        <div class="sk-card">
          <span class="sk-step__num">{i + 1}</span>
          <h3 class="sk-h3">Step title</h3>
          <SkLines n={3} />
        </div>
      ))
    }
  </div>
</SkSection>
