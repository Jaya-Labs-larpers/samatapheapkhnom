---
import type { SkAction, SkStatItem } from '~/lib/skeleton-content';
import SkSection from './SkSection.astro';
import SkLines from './SkLines.astro';
import SkStat from './SkStat.astro';

interface Props {
  heading: string;
  n?: number;
  tone?: 'default' | 'tint' | 'dark';
  items?: SkStatItem[];
  more?: SkAction | null;
  id?: string;
}

const { heading, n = 4, tone = 'default', items, more, id } = Astro.props;
---

<SkSection tone={tone} id={id}>
  <h2 class="sk-h2">{heading}</h2>
  <div class="sk-grid">
    {
      items
        ? items.map((item) => <SkStat item={item} />)
        : Array.from({ length: n }, () => (
            <div class="sk-stat">
              <div class="sk-stat__num">00</div>
              <SkLines n={2} />
            </div>
          ))
    }
  </div>
  {
    more && (
      <a href={more.href} class="sk-link">
        {more.label} →
      </a>
    )
  }
</SkSection>
