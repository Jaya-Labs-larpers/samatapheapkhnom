---
import type { SkAction, SkFaqItem } from '~/lib/skeleton-content';
import { faqJsonLd } from '~/lib/skeleton-content';
import { serializeJsonLd } from '~/lib/seo/json-ld';
import InlineLinks from '~/components/content/InlineLinks.astro';
import SkSection from './SkSection.astro';
import SkLines from './SkLines.astro';

interface Props {
  heading?: string;
  n?: number;
  items?: SkFaqItem[];
  more?: SkAction | null;
  id?: string;
}

const { heading = 'Frequently asked questions', n = 5, items, more, id } = Astro.props;
const jsonLd = items ? faqJsonLd(items) : null;
---

<SkSection narrow id={id}>
  <h2 class="sk-h2">{heading}</h2>
  <div class="sk-faq">
    {
      items
        ? items.map((item, i) => (
            <details open={i === 0} id={item.id}>
              <summary lang={item.questionLang}>{item.question}</summary>
              <p class="sk-text inline-links" lang={item.answerLang}>
                <InlineLinks text={item.answer} />
              </p>
            </details>
          ))
        : Array.from({ length: n }, (_, i) => (
            <details open={i === 0}>
              <summary>Question {i + 1}</summary>
              <SkLines n={3} />
            </details>
          ))
    }
  </div>
  {
    more && (
      <a href={more.href} class="sk-link">
        {more.label} →
      </a>
    )
  }
  {jsonLd && <script is:inline type="application/ld+json" set:html={serializeJsonLd(jsonLd)} />}
</SkSection>
