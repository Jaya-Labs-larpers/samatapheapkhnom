---
import type { Locale } from '~/lib/i18n/config';
import type { Partner } from '~/lib/content/types';
import { hasImage, imageDimensions } from '~/lib/sanity/image';
import ResponsiveImage from '~/components/media/ResponsiveImage.astro';

interface Props {
  lang: Locale;
  partners: Partner[];
}

const { lang, partners } = Astro.props;
const ordered = [...partners].sort((a, b) => (a.order ?? 0) - (b.order ?? 0));

/** Enough logos in one pass that half the track is wider than the container. */
const repeats = ordered.length > 0 ? Math.max(1, Math.ceil(16 / ordered.length)) : 0;
const loop = Array.from({ length: repeats }, (_, copy) =>
  ordered.map((partner) => ({ partner, copy })),
).flat();
const duration = Math.max(30, loop.length * 6);

/**
 * Equalise how much visual weight each logo takes: narrow logos get taller,
 * wide ones shorter, so a 1:1 mark and a 7:1 banner read at a similar size.
 */
function logoScale(partner: Partner): number {
  const { width, height } = imageDimensions(partner.logo);
  const scale = width > 0 && height > 0 ? 1.41 / Math.sqrt(width / height) : 1;
  return Math.min(1.25, scale);
}
---

<div class="sk-marquee" style={`--marquee-duration:${duration}s`}>
  <div class="sk-marquee__track">
    {
      [0, 1].map((pass) => (
        <ul class="sk-marquee__group" aria-hidden={pass === 1 ? 'true' : undefined}>
          {loop.map(({ partner, copy }) => {
            const duplicate = pass > 0 || copy > 0;
            const Logo = partner.url ? 'a' : 'span';
            return (
              <li
                class="sk-marquee__item"
                data-copy={copy}
                aria-hidden={duplicate ? 'true' : undefined}
              >
                <Logo
                  class="sk-marquee__logo"
                  style={`--logo-scale:${logoScale(partner).toFixed(3)}`}
                  href={partner.url || undefined}
                  target={partner.url ? '_blank' : undefined}
                  rel={partner.url ? 'noopener' : undefined}
                  tabindex={partner.url && duplicate ? -1 : undefined}
                >
                  {hasImage(partner.logo) ? (
                    <ResponsiveImage
                      image={partner.logo}
                      lang={lang}
                      alt={duplicate ? '' : partner.name}
                      sizes="220px"
                      aspect="5/3"
                      blurUp={false}
                      defer="visible"
                    />
                  ) : (
                    <span class="sk-marquee__wordmark">{partner.name}</span>
                  )}
                </Logo>
              </li>
            );
          })}
        </ul>
      ))
    }
  </div>
</div>

<style>
  .sk-marquee {
    --logo-size: clamp(56px, 4.5vw + 24px, 92px);
    position: relative;
    overflow: hidden;
    padding-block: 20px;
    width: 100vw;
    margin-inline: calc(50% - 50vw);
    mask-image: linear-gradient(90deg, transparent, #000 56px, #000 calc(100% - 56px), transparent);
  }
  :global(.sk-section:has(> .sk-wrap > .sk-marquee)) {
    overflow-x: clip;
  }
  .sk-marquee__track {
    display: flex;
    width: max-content;
    will-change: transform;
    backface-visibility: hidden;
    animation: sk-marquee var(--marquee-duration, 60s) linear infinite;
  }
  .sk-marquee:hover .sk-marquee__track,
  .sk-marquee:focus-within .sk-marquee__track {
    animation-play-state: paused;
  }
  .sk-marquee__group {
    display: flex;
    align-items: center;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .sk-marquee__item {
    flex: none;
    display: flex;
    align-items: center;
    justify-content: center;
    padding-inline: clamp(16px, 2vw + 8px, 40px);
  }
  .sk-marquee__logo {
    display: flex;
    align-items: center;
    justify-content: center;
    height: var(--logo-size);
  }
  .sk-marquee__logo :global(img) {
    width: auto;
    height: calc(var(--logo-size) * var(--logo-scale, 1));
    max-width: calc(var(--logo-size) * 4);
    object-fit: contain;
  }
  .sk-marquee__wordmark {
    max-width: 180px;
    font-size: 13.5px;
    line-height: 1.3;
    font-weight: 600;
    text-align: center;
    text-wrap: balance;
    color: var(--color-ink-600);
  }
  @keyframes sk-marquee {
    from {
      transform: translate3d(0, 0, 0);
    }
    to {
      transform: translate3d(-50%, 0, 0);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .sk-marquee {
      width: auto;
      margin-inline: 0;
      mask-image: none;
    }
    .sk-marquee__track {
      width: 100%;
      animation: none;
    }
    .sk-marquee__group {
      flex-wrap: wrap;
      justify-content: center;
      gap: 16px 0;
      width: 100%;
    }
    .sk-marquee__group[aria-hidden='true'],
    .sk-marquee__item[data-copy]:not([data-copy='0']) {
      display: none;
    }
  }
</style>
