---
interface GlanceItem {
  label: string;
  value: string;
  valueLang?: string;
}

interface Props {
  items: GlanceItem[];
}

const { items } = Astro.props;
---

{
  items.length > 0 && (
    <div class="pg-glance">
      <div class="pg-wrap">
        <dl class="pg-glance__grid">
          {items.map((item) => (
            <div class="pg-glance__item">
              <dt>{item.label}</dt>
              <dd lang={item.valueLang}>{item.value}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  )
}
