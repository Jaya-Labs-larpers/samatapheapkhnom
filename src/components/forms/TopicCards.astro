---
import type { Locale } from '~/lib/i18n/config';
import type { UIKey } from '~/lib/i18n/strings';
import { t } from '~/lib/i18n/utils';

/**
 * The "what can we help with?" chooser, as a row of cards. A native <select>
 * carries the value (the page's :has() rules and the submit script read it);
 * the script swaps it for the cards. Without the script the <select> stays.
 */
interface Topic {
  value: string;
  label: UIKey;
  hint: UIKey;
  tone?: 'danger';
}

interface Props {
  lang: Locale;
  id: string;
  name: string;
  labelId: string;
  topics: readonly Topic[];
}

const { lang, id, name, labelId, topics } = Astro.props;
---

<div class="topic-cards" data-topic-cards>
  <select class="field field--select topic-cards__native" id={id} {name}>
    {topics.map((topic) => <option value={topic.value}>{t(lang, topic.label)}</option>)}
  </select>

  <div class="topic-cards__grid" role="radiogroup" aria-labelledby={labelId} hidden>
    {
      topics.map((topic, index) => (
        <button
          type="button"
          class="topic-card"
          role="radio"
          data-value={topic.value}
          data-tone={topic.tone}
          aria-checked={index === 0 ? 'true' : 'false'}
          tabindex={index === 0 ? 0 : -1}
        >
          <span class="topic-card__label">{t(lang, topic.label)}</span>
          <span class="topic-card__hint">{t(lang, topic.hint)}</span>
        </button>
      ))
    }
  </div>
</div>

<script>
  function enhance(root: HTMLElement): void {
    const native = root.querySelector<HTMLSelectElement>('select');
    const grid = root.querySelector<HTMLElement>('.topic-cards__grid');
    if (!native || !grid) return;

    const cards = Array.from(grid.querySelectorAll<HTMLButtonElement>('[role="radio"]'));
    const values = cards.map((card) => card.dataset.value ?? '');

    const sync = () => {
      for (const card of cards) {
        const checked = card.dataset.value === native.value;
        card.setAttribute('aria-checked', checked ? 'true' : 'false');
        card.tabIndex = checked ? 0 : -1;
      }
    };

    const choose = (value: string) => {
      if (!values.includes(value) || native.value === value) return;
      native.value = value;
      native.dispatchEvent(new Event('change', { bubbles: true }));
      sync();
    };

    const move = (from: number, step: number) => {
      const next = cards[(from + step + cards.length) % cards.length];
      next?.focus({ preventScroll: true });
      choose(next?.dataset.value ?? '');
    };

    grid.addEventListener('click', (event) => {
      const card = (event.target as HTMLElement).closest<HTMLElement>('[role="radio"]');
      if (card) choose(card.dataset.value ?? '');
    });

    grid.addEventListener('keydown', (event) => {
      const index = cards.indexOf(document.activeElement as HTMLButtonElement);
      if (index === -1) return;
      switch (event.key) {
        case 'ArrowRight':
        case 'ArrowDown':
          event.preventDefault();
          move(index, 1);
          break;
        case 'ArrowLeft':
        case 'ArrowUp':
          event.preventDefault();
          move(index, -1);
          break;
        case 'Home':
          event.preventDefault();
          move(0, 0);
          break;
        case 'End':
          event.preventDefault();
          move(cards.length - 1, 0);
          break;
        case 'Enter':
        case ' ':
          event.preventDefault();
          choose(cards[index]?.dataset.value ?? '');
          break;
      }
    });

    // Links elsewhere on the site arrive as /contact/?topic=partner and so on.
    const requested = new URLSearchParams(window.location.search).get('topic');
    if (requested && values.includes(requested)) native.value = requested;

    native.addEventListener('change', sync);
    native.form?.addEventListener('reset', () => requestAnimationFrame(sync));
    sync();
    grid.hidden = false;
    root.dataset.enhanced = '';
  }

  document.querySelectorAll<HTMLElement>('[data-topic-cards]').forEach(enhance);
</script>
