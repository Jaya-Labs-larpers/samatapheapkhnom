---
import type { Locale } from '~/lib/i18n/config';
import type { LocaleBlocks } from '~/lib/content/types';
import {
  getActivities,
  getActivity,
  getImpactStats,
  getPage,
  getProgram,
  getPrograms,
  getSiteSettings,
  getStories,
} from '~/lib/content';
import { blockText } from '~/lib/content/sections';
import { langAttr, localizePath, pick } from '~/lib/i18n/utils';
import { statItem } from '~/lib/skeleton-content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import SkHero from '~/components/skeleton/SkHero.astro';
import SkSection from '~/components/skeleton/SkSection.astro';
import SkStat from '~/components/skeleton/SkStat.astro';
import ButterflyEffect from '~/components/lab/ButterflyEffect.astro';
import KhanExplorer from '~/components/lab/KhanExplorer.astro';
import FamiliesQuiz from '~/components/lab/FamiliesQuiz.astro';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;

const [orgStats, programList, stories, activityList, settings, about, impact] = await Promise.all([
  getImpactStats(),
  getPrograms(),
  getStories(),
  getActivities(),
  getSiteSettings(),
  getPage('about'),
  getPage('impact'),
]);
const programs = (await Promise.all(programList.map((entry) => getProgram(entry.slug)))).filter(
  (program) => program !== null,
);
const activities = (await Promise.all(activityList.map((entry) => getActivity(entry.slug)))).filter(
  (activity) => activity !== null,
);

const english = (label?: { en?: string | null } | null) => label?.en ?? '';
const bodyText = (body?: LocaleBlocks | null) => (body?.en ?? []).map(blockText).join(' ');

const families = orgStats.find((stat) => /famil/i.test(english(stat.label)));
const facts = [
  ...orgStats.filter((stat) => stat !== families).map((stat) => ({ stat })),
  ...programs.flatMap((program) =>
    (program.impactStats ?? []).map((stat) => ({ stat, programme: program.title })),
  ),
];
const khanStats = orgStats.filter((stat) => /khan|sangkat/i.test(english(stat.label)));

const titled = (value: Parameters<typeof pick<string>>[0]) => {
  const picked = pick(value, lang);
  return { label: picked.value ?? '', labelLang: langAttr(picked) };
};
const sources = [
  {
    kind: 'Office',
    label: 'SKO office',
    href: localizePath('/contact', lang),
    text: english(settings.address),
  },
  ...programs.map((program) => ({
    kind: 'Programme',
    ...titled(program.title),
    href: localizePath(`/programs/${program.slug}`, lang),
    text: `${english(program.summary)} ${bodyText(program.body)}`,
  })),
  ...stories.map((story) => ({
    kind: 'Story',
    label: story.personName ?? '',
    href: localizePath(story.program ? `/programs/${story.program.slug}` : '/impact', lang),
    text: `${english(story.quote)} ${bodyText(story.body)}`,
  })),
  ...activities.map((activity) => ({
    kind: 'Activity',
    ...titled(activity.title),
    href: localizePath(`/activities/${activity.slug}`, lang),
    text: `${english(activity.title)} ${english(activity.excerpt)} ${bodyText(activity.body)}`,
  })),
  ...[
    { page: about, path: '/about' },
    { page: impact, path: '/impact' },
  ].flatMap(({ page, path }) =>
    page
      ? [
          {
            kind: 'Page',
            ...titled(page.title),
            href: localizePath(path, lang),
            text: bodyText(page.body),
          },
        ]
      : [],
  ),
];
---

<BaseLayout
  lang={lang}
  title="Lab"
  description="Interactive ideas being tested for the SKO website redesign."
  noindex
>
  <SkHero
    title="Lab"
    titleLang={lang === 'en' ? undefined : 'en'}
    intro="Interactive ideas we are testing for the redesign. This page is not linked from the site."
    introLang={lang === 'en' ? undefined : 'en'}
    actions={[]}
  />

  {
    families && (
      <SkSection id="butterflies">
        <h2 class="sk-h2" lang="en">
          The Butterfly Effect
        </h2>
        <ButterflyEffect lang={lang} families={families} facts={facts} />
      </SkSection>
    )
  }

  <SkSection tone="tint" id="khans">
    <h2 class="sk-h2" lang="en">Where we work, khan by khan</h2>
    {
      khanStats.length > 0 && (
        <div class="sk-grid">
          {khanStats.map((stat) => (
            <SkStat item={statItem(stat, lang)} />
          ))}
        </div>
      )
    }
    <p class="sk-small" lang="en">
      Schematic: each tile sits roughly where its khan is, not on its boundaries. Matches come from
      khan names in what SKO has already published; a khan field on posts would make them exact.
    </p>
    <KhanExplorer sources={sources} />
  </SkSection>

  <SkSection id="quiz" narrow>
    <h2 class="sk-h2" lang="en">Families, not orphanages</h2>
    <p class="sk-small" lang="en">
      <strong>Draft.</strong> The facts and wording need SKO's review before this goes anywhere else.
    </p>
    <FamiliesQuiz lang={lang} />
  </SkSection>
</BaseLayout>
