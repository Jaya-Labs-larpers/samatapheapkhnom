---
import type { Locale } from '~/lib/i18n/config';
import { pick, t, text } from '~/lib/i18n/utils';
import {
  getActivities,
  getImpactStats,
  getPartners,
  getPrograms,
  getSiteSettings,
  getStories,
} from '~/lib/content';
import { getHomeData } from '~/data';
import BaseLayout from '~/layouts/BaseLayout.astro';
import Hero from '~/components/home/Hero.astro';
import Programs from '~/components/home/Programs.astro';
import PartnerLogos from '~/components/home/PartnerLogos.astro';
import StoriesCarousel from '~/components/home/StoriesCarousel.astro';
import ImpactBand from '~/components/home/ImpactBand.astro';
import LatestActivities from '~/components/home/LatestActivities.astro';
import Explainers from '~/components/home/Explainers.astro';
import ClosingCta from '~/components/home/ClosingCta.astro';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;

const [settings, stats, programs, activities, partners, stories] = await Promise.all([
  getSiteSettings(),
  getImpactStats(),
  getPrograms(),
  getActivities(),
  getPartners(),
  getStories(),
]);

const orgName = text(settings.orgName, lang);
const tagline = pick(settings.tagline, lang);
const brand = settings.orgShortName ?? 'SKO';
const seoTitle = t(lang, 'seoHome');
const { data: home, fallback } = getHomeData(lang);
const explainers = home.explainers.length > 0 ? home.explainers : fallback.explainers;
---

<BaseLayout
  lang={lang}
  title={seoTitle ? `${seoTitle} · ${brand}` : orgName}
  plainTitle
  description={t(lang, 'metaHome') || tagline.value || undefined}
  ogImage={settings.ogImage}
>
  <Hero lang={lang} settings={settings} />
  <Programs lang={lang} programs={programs} />
  <PartnerLogos lang={lang} partners={partners} />
  <StoriesCarousel lang={lang} stories={stories} />
  <ImpactBand lang={lang} stats={stats} />
  <LatestActivities lang={lang} activities={activities.slice(0, 4)} />
  <Explainers lang={lang} items={explainers} />
  <ClosingCta lang={lang} />
</BaseLayout>
