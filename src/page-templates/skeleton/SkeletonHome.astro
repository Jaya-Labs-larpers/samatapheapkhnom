---
import type { Locale } from '~/lib/i18n/config';
import { langAttr, localizePath, pick, t, text } from '~/lib/i18n/utils';
import {
  getDirectorMessage,
  getFeaturedActivities,
  getImpactStats,
  getPartners,
  getPrograms,
  getSiteSettings,
  getStories,
} from '~/lib/content';
import { ctaActions, heroActions, postItem, programCard, tStrict } from '~/lib/skeleton-content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import SkSection from '~/components/skeleton/SkSection.astro';
import SkHero from '~/components/skeleton/SkHero.astro';
import SkDirector from '~/components/skeleton/SkDirector.astro';
import SkPosts from '~/components/skeleton/SkPosts.astro';
import SkSplitCta from '~/components/skeleton/SkSplitCta.astro';
import SkPartnerMarquee from '~/components/skeleton/SkPartnerMarquee.astro';
import SkStoryText from '~/components/skeleton/SkStoryText.astro';
import SkMapProof from '~/components/skeleton/SkMapProof.astro';
import SkPhotoCards from '~/components/skeleton/SkPhotoCards.astro';
import SkStorySlider from '~/components/skeleton/SkStorySlider.astro';
import SkFeatureBanner from '~/components/skeleton/SkFeatureBanner.astro';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;

const [settings, stats, director, programs, featured, partners, stories] = await Promise.all([
  getSiteSettings(),
  getImpactStats(),
  getDirectorMessage(),
  getPrograms(),
  getFeaturedActivities(3),
  getPartners(),
  getStories(),
]);

const orgName = text(settings.orgName, lang);
const tagline = pick(settings.tagline, lang);
const brand = settings.orgShortName ?? 'SKO';
const seoTitle = tStrict(lang, 'seoHome');
const ctaImage = settings.homeHero?.[1] ?? programs.find((program) => program.image)?.image ?? null;
const bannerProgram = programs.find((program) => program.image && pick(program.title, lang).value);
const bannerTitle = bannerProgram ? pick(bannerProgram.title, lang) : null;
---

<BaseLayout
  lang={lang}
  title={seoTitle ? `${seoTitle} · ${brand}` : orgName}
  plainTitle
  description={tStrict(lang, 'metaHome') || tagline.value || undefined}
  ogImage={settings.ogImage}
  noindex
>
  <SkHero
    home
    lang={lang}
    image={settings.homeHero?.[0] ?? null}
    title={tagline.value ?? orgName}
    titleLang={langAttr(tagline)}
    eyebrow={tStrict(lang, 'homeEyebrow')}
    actions={heroActions(lang)}
  />

  <SkStoryText
    lang={lang}
    label={tStrict(lang, 'navAbout')}
    text={tStrict(lang, 'homeHeroIntro')}
    link={{
      label: tStrict(lang, 'homeAboutLink') || tStrict(lang, 'learnMore'),
      href: localizePath('/about', lang),
    }}
  />

  <SkStorySlider lang={lang} heading={t(lang, 'storiesHeading')} stories={stories} />

  <SkPhotoCards
    lang={lang}
    heading={tStrict(lang, 'whatWeDo')}
    items={programs.map((program) =>
      programCard(program, lang, tStrict(lang, 'viewAllPrograms') || tStrict(lang, 'viewAll')),
    )}
    more={{
      label: tStrict(lang, 'viewAllPrograms') || tStrict(lang, 'viewAll'),
      href: localizePath('/programs', lang),
    }}
  />

  <SkMapProof lang={lang} stats={stats} />

  <SkDirector
    lang={lang}
    director={director}
    heading={tStrict(lang, 'directorMessage')}
    link={{ label: tStrict(lang, 'readMore'), href: localizePath('/about#director', lang) }}
  />

  {
    partners.length > 0 && (
      <SkSection>
        <h2 class="sk-h2" style="text-align:center">
          {tStrict(lang, 'trustedBy')}
        </h2>
        <SkPartnerMarquee lang={lang} partners={partners} />
      </SkSection>
    )
  }

  {
    bannerProgram && bannerTitle?.value && (
      <SkFeatureBanner
        lang={lang}
        image={bannerProgram.image}
        title={bannerTitle.value}
        titleLang={langAttr(bannerTitle)}
        action={{
          label: tStrict(lang, 'learnMore'),
          href: localizePath(`/programs/${bannerProgram.slug}`, lang),
        }}
      />
    )
  }

  <SkPosts
    heading={tStrict(lang, 'latestActivities')}
    n={featured.length}
    lang={lang}
    readMore={tStrict(lang, 'readMore')}
    items={featured.map((activity) => postItem(activity, lang))}
    more={{ label: tStrict(lang, 'allActivities'), href: localizePath('/activities', lang) }}
  />

  <SkSplitCta
    lang={lang}
    card
    image={ctaImage}
    heading={tStrict(lang, 'ctaHomeTitle')}
    body={tStrict(lang, 'ctaHomeBody')}
    actions={ctaActions(lang)}
  />
</BaseLayout>
