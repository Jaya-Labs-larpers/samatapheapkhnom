---
import type { Locale } from '~/lib/i18n/config';
import { getImpactStats, getPage, getPrograms, getStories } from '~/lib/content';
import { langAttr, localizePath, pick } from '~/lib/i18n/utils';
import { resolveSeo } from '~/lib/seo';
import { ctaActions, programRow, statItem, storyCard, tStrict } from '~/lib/skeleton-content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import Breadcrumbs from '~/components/layout/Breadcrumbs.astro';
import SkHero from '~/components/skeleton/SkHero.astro';
import SkStats from '~/components/skeleton/SkStats.astro';
import SkBody from '~/components/skeleton/SkBody.astro';
import SkRows from '~/components/skeleton/SkRows.astro';
import SkSection from '~/components/skeleton/SkSection.astro';
import SkCta from '~/components/skeleton/SkCta.astro';
import SkSubnav from '~/components/skeleton/SkSubnav.astro';
import { impactProjectsAvailable, impactProjectsPath } from '~/lib/impact-pages';

interface Props {
  lang: Locale;
  projects?: boolean;
}

const { lang, projects = false } = Astro.props;
const hasProjects = await impactProjectsAvailable(lang);
const [stats, page, programs, stories] = await Promise.all([
  getImpactStats(),
  getPage('impact'),
  getPrograms(),
  getStories(),
]);

const title = pick(page?.title, lang);
const intro = pick(page?.intro, lang);
const impactTitle = title.value ?? tStrict(lang, 'pageImpact');
const heading = projects ? tStrict(lang, 'impactProjects') : impactTitle;
const introText = intro.value ?? tStrict(lang, 'introImpact');
const story = stories[0] ? storyCard(stories[0], lang) : null;
const seo = resolveSeo(projects ? null : page?.seo, lang, {
  title: heading,
  description: introText,
  image: page?.heroImage,
});
---

<BaseLayout
  lang={lang}
  title={seo.title}
  description={seo.description}
  ogImage={seo.ogImage}
  noindex
>
  <SkHero
    title={heading}
    titleLang={projects ? undefined : langAttr(title)}
    intro={projects ? null : introText}
    introLang={projects ? undefined : langAttr(intro)}
    actions={[]}
  >
    <Breadcrumbs
      slot="before"
      lang={lang}
      trail={projects
        ? [{ label: impactTitle, path: '/impact' }, { label: heading }]
        : [{ label: heading }]}
    />
  </SkHero>

  <SkSubnav
    lang={lang}
    pathname={Astro.url.pathname}
    items={[
      { key: 'navImpact', path: '/impact' },
      ...(hasProjects ? [{ key: 'impactProjects' as const, path: impactProjectsPath }] : []),
      { key: 'navActivities', path: '/activities' },
      { key: 'ourPrograms', path: '/programs' },
    ]}
  />

  {
    !projects && stats.length > 0 && (
      <SkStats
        id="results"
        heading={tStrict(lang, 'resultsAtAGlance')}
        items={stats.map((stat) => statItem(stat, lang))}
        more={{ label: tStrict(lang, 'seeReports'), href: localizePath('/reports', lang) }}
      />
    )
  }

  {
    projects ? (
      <SkBody lang={lang} body={page?.body} showLead={false} />
    ) : hasProjects ? (
      <SkBody lang={lang} body={page?.body} only={[]} showLead />
    ) : (
      <SkBody lang={lang} body={page?.body} />
    )
  }

  {
    !projects && programs.length > 0 && (
      <SkRows
        id="programs"
        heading={tStrict(lang, 'ourPrograms')}
        items={programs.map((program, index) => programRow(program, index, lang))}
        more={{ label: tStrict(lang, 'viewAll'), href: localizePath('/programs', lang) }}
      />
    )
  }

  {
    !projects && story && (
      <SkSection tone="tint">
        <figure class="sk-figure">
          {story.quote && (
            <blockquote class="sk-quote" lang={story.quoteLang}>
              {story.quote}
            </blockquote>
          )}
          <figcaption class="sk-small">
            — {story.cite}
            {story.citeRole && (
              <span lang={story.citeRoleLang}>
                , {story.citeHref ? <a href={story.citeHref}>{story.citeRole}</a> : story.citeRole}
              </span>
            )}
          </figcaption>
        </figure>
      </SkSection>
    )
  }

  <SkCta heading={tStrict(lang, 'ctaImpactTitle')} actions={ctaActions(lang)} />
</BaseLayout>
