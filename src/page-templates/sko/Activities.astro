---
import type { Locale } from '~/lib/i18n/config';
import type { Activity } from '~/lib/content/types';
import { localizePath, pick } from '~/lib/i18n/utils';
import { stripInlineLinks } from '~/lib/inline-links';
import { canonicalUrl, collectionPageJsonLd } from '~/lib/seo/page-schema';
import { postItem, tStrict } from '~/lib/skeleton-content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import EmptyState from '~/components/content/EmptyState.astro';
import Pagination from '~/components/content/Pagination.astro';
import ResponsiveImage from '~/components/media/ResponsiveImage.astro';
import PageSolo from '~/components/page/PageSolo.astro';
import SectionHead from '~/components/page/SectionHead.astro';

interface Props {
  lang: Locale;
  activities: Activity[];
  currentPage: number;
  totalPages: number;
}

const { lang, activities, currentPage, totalPages } = Astro.props;
const heading = tStrict(lang, 'pageActivities');
const items = activities.map((activity) => postItem(activity, lang));
const lead = currentPage === 1 ? items[0] : undefined;
const rest = currentPage === 1 ? items.slice(1) : items;

const hrefFor = (page: number) =>
  page === 1 ? localizePath('/activities', lang) : localizePath(`/activities/page/${page}`, lang);

const title = tStrict(lang, 'seoActivities') || heading;
const description =
  tStrict(lang, 'metaActivities') || stripInlineLinks(tStrict(lang, 'introActivities'));
const collection = collectionPageJsonLd({
  pathname: Astro.url.pathname,
  name: title,
  description,
  parts: activities.map((activity) => ({
    name: pick(activity.title, lang).value ?? '',
    url: canonicalUrl(localizePath(`/activities/${activity.slug}`, lang)),
  })),
});
---

<BaseLayout lang={lang} title={title} description={description} noindex darkHero jsonLd={collection}>
  <PageSolo
    full
    lang={lang}
    title={heading}
    intro={tStrict(lang, 'introActivities')}
    trail={[{ label: tStrict(lang, 'navImpact'), path: '/impact' }, { label: heading }]}
  />

  <section class="pg-section">
    <div class="pg-wrap">
      {
        activities.length === 0 ? (
          <EmptyState message={tStrict(lang, 'emptyActivities')} />
        ) : (
          <>
            <SectionHead heading={tStrict(lang, 'allActivities')} />
            {lead && (
              <article class="pg-feature">
                {lead.image && (
                  <div class="pg-feature__media clip-reveal">
                    <ResponsiveImage
                      image={lead.image}
                      lang={lang}
                      alt=""
                      aspect="4/3"
                      sizes="(min-width: 64rem) 50vw, 100vw"
                    />
                  </div>
                )}
                <div class="pg-feature__body">
                  {lead.category && (
                    <p class="pg-meta">
                      <span class="pg-tag">{lead.category}</span>
                    </p>
                  )}
                  <h3 lang={lead.titleLang}>
                    <a href={lead.href}>{lead.title}</a>
                  </h3>
                  <p class="pg-meta">
                    <time datetime={lead.datetime}>{lead.date}</time>
                    {lead.author && <span>{lead.author}</span>}
                  </p>
                  {lead.excerpt && <p lang={lead.excerptLang}>{lead.excerpt}</p>}
                  <div>
                    <a class="pg-link" href={lead.href} style="margin-top:0.875rem">
                      {tStrict(lang, 'readMore')} <span aria-hidden="true">→</span>
                    </a>
                  </div>
                </div>
              </article>
            )}
            {rest.length > 0 && (
              <div class="pg-grid pg-grid--posts">
                {rest.map((item) => (
                  <article class="pg-card">
                    {item.image && (
                      <div class="pg-card__media clip-reveal">
                        <ResponsiveImage
                          image={item.image}
                          lang={lang}
                          alt=""
                          aspect="16/10"
                          sizes="(min-width: 64rem) 380px, (min-width: 40rem) 50vw, 100vw"
                        />
                      </div>
                    )}
                    <div class="pg-card__body">
                      {item.category && (
                        <p class="pg-meta">
                          <span class="pg-tag">{item.category}</span>
                        </p>
                      )}
                      <h3 class="pg-h3" lang={item.titleLang}>
                        <a href={item.href} style="color:inherit;text-decoration:none">
                          {item.title}
                        </a>
                      </h3>
                      <p class="pg-meta">
                        <time datetime={item.datetime}>{item.date}</time>
                        {item.author && <span>{item.author}</span>}
                      </p>
                      {item.excerpt && <p lang={item.excerptLang}>{item.excerpt}</p>}
                      <div>
                        <a class="pg-link" href={item.href} style="margin-top:0.875rem">
                          {tStrict(lang, 'readMore')} <span aria-hidden="true">→</span>
                        </a>
                      </div>
                    </div>
                  </article>
                ))}
              </div>
            )}
          </>
        )
      }
      <Pagination lang={lang} current={currentPage} total={totalPages} hrefFor={hrefFor} />
    </div>
  </section>
</BaseLayout>
