---
import type { Locale } from '~/lib/i18n/config';
import type { TeamMember } from '~/lib/content/types';
import { getSiteSettings, getTeam } from '~/lib/content';
import { ctaActions, tStrict } from '~/lib/skeleton-content';
import { langAttr, pick, text } from '~/lib/i18n/utils';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { hasImage } from '~/lib/sanity/image';
import ResponsiveImage from '~/components/media/ResponsiveImage.astro';
import PageSolo from '~/components/page/PageSolo.astro';
import SectionHead from '~/components/page/SectionHead.astro';
import BandCta from '~/components/page/BandCta.astro';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;

const [settings, team] = await Promise.all([getSiteSettings(), getTeam()]);
const photo = settings.homeHero?.[0] ?? null;
const heading = tStrict(lang, 'ourTeam');
const description = `${heading} — ${text(settings.orgName, lang)}`;

const ids = new Set(team.map((member) => member._id));
const reportsOf = (id: string) => team.filter((member) => member.reportsTo === id);
const roots = team.filter((member) => !member.reportsTo || !ids.has(member.reportsTo));
const [head] = roots.length === 1 ? roots : [];
const leads = head ? reportsOf(head._id) : roots;
const leadership = [...(head ? [head] : []), ...leads];
const fieldTeams = leads
  .map((lead) => ({ lead, staff: reportsOf(lead._id) }))
  .filter((entry) => entry.staff.length > 0);

const segmenter = new Intl.Segmenter(lang, { granularity: 'grapheme' });
const monogram = (name: string | null | undefined) =>
  (name ?? '')
    .split(/\s+/)
    .filter(Boolean)
    .slice(0, 2)
    .map((word) => [...segmenter.segment(word)][0]?.segment ?? '')
    .join('');

const label = (member: TeamMember) => {
  const name = pick(member.name, lang);
  const role = pick(member.role, lang);
  return { name: name.value, nameLang: langAttr(name), role: role.value, roleLang: langAttr(role) };
};
---

<BaseLayout lang={lang} title={heading} description={description} noindex>
  <PageSolo lang={lang} title={heading} trail={[{ label: heading }]}>
    {
      photo && (
        <figure
          slot="media"
          class="pg-solo__media load-clip"
          data-reveal-mobile="true"
          style="--load-delay:450ms"
        >
          <ResponsiveImage image={photo} lang={lang} keep eager sizes="100vw" aspect="21/9" />
        </figure>
      )
    }
  </PageSolo>

  {
    leadership.length > 0 && (
      <section class="pg-section">
        <div class="pg-wrap">
          <SectionHead
            eyebrow={tStrict(lang, 'orgStructure')}
            heading={tStrict(lang, 'teamLeadership')}
          />
          <div class="pg-grid pg-grid--3">
            {leadership.map((member) => {
              const info = label(member);
              return (
                <div class="pg-person">
                  <span class="pg-avatar" aria-hidden="true">
                    {hasImage(member.photo) ? (
                      <ResponsiveImage
                        image={member.photo}
                        lang={lang}
                        alt=""
                        keep
                        aspect="1/1"
                        sizes="52px"
                      />
                    ) : (
                      monogram(info.name)
                    )}
                  </span>
                  <div>
                    <b lang={info.nameLang}>{info.name}</b>
                    {info.role && <span lang={info.roleLang}>{info.role}</span>}
                  </div>
                </div>
              );
            })}
          </div>
        </div>
      </section>
    )
  }

  {
    fieldTeams.length > 0 && (
      <section class="pg-section pg-section--tint">
        <div class="pg-wrap">
          <SectionHead heading={tStrict(lang, 'teamFieldTeams')} />
          <div class="pg-teams">
            {fieldTeams.map(({ lead, staff }) => {
              const info = label(lead);
              return (
                <div class="pg-team">
                  {info.role && (
                    <span class="pg-kicker" lang={info.roleLang}>
                      {info.role}
                    </span>
                  )}
                  <b lang={info.nameLang}>{info.name}</b>
                  <div class="pg-names">
                    {staff.map((member) => {
                      const memberInfo = label(member);
                      return (
                        <span lang={memberInfo.nameLang}>
                          {memberInfo.name}
                          {memberInfo.role && (
                            <>
                              {' · '}
                              <span lang={memberInfo.roleLang} style="display:inline;margin:0">
                                {memberInfo.role}
                              </span>
                            </>
                          )}
                        </span>
                      );
                    })}
                  </div>
                </div>
              );
            })}
          </div>
        </div>
      </section>
    )
  }

  <BandCta
    heading={tStrict(lang, 'ctaAboutTitle')}
    body={tStrict(lang, 'ctaAboutBody')}
    actions={ctaActions(lang)}
  />
</BaseLayout>
