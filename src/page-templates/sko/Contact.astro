---
import type { Locale } from '~/lib/i18n/config';
import { getSiteSettings } from '~/lib/content';
import { langAttr, pick } from '~/lib/i18n/utils';
import { stripInlineLinks } from '~/lib/inline-links';
import { contactPageJsonLd, officeOpeningHours } from '~/lib/seo/page-schema';
import { donateHref, tStrict } from '~/lib/skeleton-content';
import { donatePageLive } from '~/config/donation';
import BaseLayout from '~/layouts/BaseLayout.astro';
import ContactForm from '~/components/forms/ContactForm.astro';
import InlineLinks from '~/components/content/InlineLinks.astro';
import Icon from '~/components/Icon.astro';
import SkSection from '~/components/skeleton/SkSection.astro';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;

const settings = await getSiteSettings();
const address = pick(settings.address, lang);
const hours = pick(settings.officeHours, lang);
const safeguarding = pick(settings.safeguardingContact, lang);
const heading = tStrict(lang, 'pageContact');
const tel = (phone: string) => `tel:${phone.replace(/[^+\d]/g, '')}`;
const withContact = (value: string) =>
  value.replace('{phone}', settings.phone ?? '').replace('{email}', settings.email ?? '');
const intro = withContact(tStrict(lang, 'introContact'));
const title = tStrict(lang, 'seoContact') || heading;
const description = withContact(tStrict(lang, 'metaContact')) || stripInlineLinks(intro);
const contactPage = contactPageJsonLd({ pathname: Astro.url.pathname, name: title, description });
const safeguardingPolicy = tStrict(lang, 'contactSafeguardingPolicy');
---

<BaseLayout
  lang={lang}
  title={title}
  description={description}
  noindex
  jsonLd={contactPage}
  orgJsonLd={{ openingHoursSpecification: officeOpeningHours }}
>
  <SkSection class="pt-8 pb-12 lg:pt-12 lg:pb-16">
    <div class="contact-layout contact-desk">
      <h1 class="sk-h1 contact-layout__title">{tStrict(lang, 'formPanelTitleGeneral')}</h1>

      <div class="contact-layout__form">
        <ContactForm lang={lang} id="form-contact" />
      </div>

      <ul class="contact-info contact-layout__info">
        {
          settings.email && (
            <li>
              <Icon name="envelope" />
              <a href={`mailto:${settings.email}`} style="overflow-wrap:anywhere">
                {settings.email}
              </a>
            </li>
          )
        }
        {
          settings.phone && (
            <li>
              <Icon name="phone" />
              <span>
                <a href={tel(settings.phone)}>{settings.phone}</a>
                {hours.value && <small lang={langAttr(hours)}>{hours.value}</small>}
              </span>
            </li>
          )
        }
        {
          address.value && (
            <li>
              <Icon name="map-pin" />
              <span>
                <span style="white-space:pre-line" lang={langAttr(address)}>
                  {address.value}
                </span>
                {settings.mapUrl && (
                  <a href={settings.mapUrl} rel="noopener noreferrer" target="_blank">
                    {tStrict(lang, 'viewOnGoogleMaps')}
                  </a>
                )}
              </span>
            </li>
          )
        }
      </ul>

      <div
        class="safeguarding-panel contact-layout__safe"
        role="region"
        aria-label={tStrict(lang, 'safeguardingPanelTitle')}
      >
        <h2 class="safeguarding-panel__title">{tStrict(lang, 'safeguardingPanelTitle')}</h2>
        {
          safeguarding.value && (
            <p class="safeguarding-panel__body" lang={langAttr(safeguarding)}>
              {safeguarding.value}
            </p>
          )
        }
        {
          safeguardingPolicy && (
            <p class="safeguarding-panel__body inline-links">
              <InlineLinks text={safeguardingPolicy} />
            </p>
          )
        }
        <div class="sk-actions" style="margin-top:20px">
          {
            settings.phone && (
              <a href={tel(settings.phone)} class="sk-btn">
                {settings.phone}
              </a>
            )
          }
          {
            settings.safeguardingEmail && (
              <a
                href={`mailto:${settings.safeguardingEmail}`}
                class="sk-btn sk-btn--outline"
                style="overflow-wrap:anywhere"
              >
                {settings.safeguardingEmail}
              </a>
            )
          }
        </div>
      </div>

      {
        donatePageLive && (
          <div class="contact-layout__band sk-actions">
            <a href={donateHref(lang)} class="sk-btn">
              {tStrict(lang, 'donate')}
            </a>
          </div>
        )
      }
    </div>
  </SkSection>
</BaseLayout>
