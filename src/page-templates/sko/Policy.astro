---
import type { Locale } from '~/lib/i18n/config';
import type { UIKey } from '~/lib/i18n/strings';
import { getPage } from '~/lib/content';
import { langAttr, pick } from '~/lib/i18n/utils';
import { blocksToPlainText } from '~/lib/portable-text';
import { resolveSeo } from '~/lib/seo';
import { faqItems, tStrict } from '~/lib/skeleton-content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import RichText from '~/components/content/RichText.astro';
import PageSolo from '~/components/page/PageSolo.astro';
import SectionHead from '~/components/page/SectionHead.astro';
import Accordion from '~/components/page/Accordion.astro';

interface Props {
  lang: Locale;
  slug: string;
  /** Used when the CMS page is missing entirely. */
  fallbackTitleKey: UIKey;
}

const { lang, slug, fallbackTitleKey } = Astro.props;

const page = await getPage(slug);
const title = pick(page?.title, lang);
const intro = pick(page?.intro, lang);
const heading = title.value ?? tStrict(lang, fallbackTitleKey);
const seo = resolveSeo(page?.seo, lang, {
  title: heading,
  description: intro.value ?? blocksToPlainText(pick(page?.body, lang).value),
  image: page?.heroImage,
});
const faqs = faqItems(page?.faqs, lang);
---

<BaseLayout
  lang={lang}
  title={seo.title}
  description={seo.description}
  ogImage={seo.ogImage}
  noindex
  darkHero
>
  <PageSolo
    full
    lang={lang}
    title={heading}
    titleLang={langAttr(title)}
    intro={intro.value}
    introLang={langAttr(intro)}
    trail={[{ label: heading }]}
  />

  <section class="pg-section">
    <div class="pg-wrap">
      <div class="pg-prose">
        <RichText blocks={page?.body} lang={lang} />
        <slot />
      </div>
    </div>
  </section>

  {
    faqs.length > 0 && (
      <section class="pg-section pg-section--tint">
        <div class="pg-wrap">
          <SectionHead heading={tStrict(lang, 'faqHeading')} />
          <Accordion items={faqs} />
        </div>
      </section>
    )
  }
</BaseLayout>
