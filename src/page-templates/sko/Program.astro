---
import type { Locale } from '~/lib/i18n/config';
import type { LocaleBlocks, PortableBlock, Program } from '~/lib/content/types';
import { getPrograms, getStories } from '~/lib/content';
import { ACTIVITY_LIMITS, blockText } from '~/lib/content/sections';
import { langAttr, localizePath, pick } from '~/lib/i18n/utils';
import { resolveSeo } from '~/lib/seo';
import { serviceJsonLd } from '~/lib/seo/page-schema';
import { ctaActions, programCard, statItem, tStrict } from '~/lib/skeleton-content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import RichText from '~/components/content/RichText.astro';
import ResponsiveImage from '~/components/media/ResponsiveImage.astro';
import SectionedBody from '~/components/content/SectionedBody.astro';
import PageHero from '~/components/page/PageHero.astro';
import GlanceBar from '~/components/page/GlanceBar.astro';
import SectionHead from '~/components/page/SectionHead.astro';
import BandCta from '~/components/page/BandCta.astro';

interface Props {
  lang: Locale;
  program: Program;
}

const { lang, program } = Astro.props;

const [programs, stories] = await Promise.all([getPrograms(), getStories()]);

const title = pick(program.title, lang);
const summary = pick(program.summary, lang);
const heading = title.value ?? '';
const stats = program.impactStats ?? [];

/* With a story, the body's "Impact" section is told once, in the story band. */
const story = stories.find((entry) => entry.program?.slug === program.slug);
const isImpactHeading = (block: PortableBlock) =>
  block._type === 'block' && block.style === 'h2' && /impact|លទ្ធផល/i.test(blockText(block));

let body: LocaleBlocks | null | undefined = program.body;
const impact: LocaleBlocks = {};
if (story && program.body) {
  body = {};
  for (const [locale, blocks] of Object.entries(program.body) as [
    Locale,
    PortableBlock[] | null,
  ][]) {
    const start = (blocks ?? []).findIndex(isImpactHeading);
    if (!blocks || start < 0) {
      body[locale] = blocks;
      continue;
    }
    const next = blocks.findIndex(
      (block, i) => i > start && block._type === 'block' && block.style === 'h2',
    );
    const end = next < 0 ? blocks.length : next;
    body[locale] = [...blocks.slice(0, start), ...blocks.slice(end)];
    impact[locale] = blocks.slice(start + 1, end);
  }
}
const hasImpact = Object.values(impact).some((blocks) => blocks && blocks.length > 0);
const quote = story ? pick(story.quote, lang) : null;
const storyRole = story ? pick(story.personRole, lang) : null;

const position = programs.findIndex((entry) => entry.slug === program.slug) + 1;
const pad = (n: number) => String(n).padStart(2, '0');
const activitiesLink = tStrict(lang, 'activitiesFromProgram');

const otherPrograms = programs.filter((entry) => entry.slug !== program.slug);
const glance = [
  { label: tStrict(lang, 'glanceWhere'), value: tStrict(lang, 'navPhnomPenh') },
  { label: tStrict(lang, 'programMethod'), value: tStrict(lang, 'programMethodValue') },
].filter((item) => item.value);

const steps = [
  { title: tStrict(lang, 'programsStepVisit'), body: tStrict(lang, 'programsStepVisitBody') },
  { title: tStrict(lang, 'programsStepGoals'), body: tStrict(lang, 'programsStepGoalsBody') },
  {
    title: tStrict(lang, 'programsStepServices'),
    body: tStrict(lang, 'programsStepServicesBody'),
  },
];

const statCards = stats.map((stat) => {
  const item = statItem(stat, lang);
  const percent = /^\d+(\.\d+)?%$/.test(item.value) ? Number.parseFloat(item.value) : null;
  return { ...item, percent };
});

const seo = resolveSeo(program.seo, lang, {
  title: heading,
  description: summary.value,
  image: program.image,
});
const service = serviceJsonLd({
  slug: program.slug,
  pathname: Astro.url.pathname,
  name: heading,
  description: seo.description,
});
---

<BaseLayout
  lang={lang}
  title={seo.title}
  description={seo.description}
  ogImage={seo.ogImage}
  noindex
  jsonLd={service}
>
  <PageHero
    lang={lang}
    title={heading}
    titleLang={langAttr(title)}
    intro={summary.value}
    introLang={langAttr(summary)}
    trail={[{ label: tStrict(lang, 'pagePrograms'), path: '/programs' }, { label: heading }]}
    eyebrow={position > 0
      ? `${tStrict(lang, 'programLabel')} ${pad(position)} / ${pad(programs.length)}`
      : null}
    image={program.image}
    caption={pick(program.image?.caption ?? program.image?.alt, lang).value}
  />

  {glance.length > 0 && <GlanceBar items={glance} />}

  {
    statCards.length > 0 && (
      <section class="pg-section">
        <div class="pg-wrap">
          <SectionHead heading={tStrict(lang, 'resultsAtAGlance')} />
          <div class="pg-bento">
            {statCards[0] && (
              <div class="pg-bento__stat pg-bento__stat--blue">
                <span lang={statCards[0].labelLang}>{statCards[0].label}</span>
                <div>
                  {statCards[0].prefix && (
                    <span lang={statCards[0].prefixLang}>{statCards[0].prefix}</span>
                  )}
                  <b>
                    {statCards[0].value}
                    {statCards[0].suffix && <small>{statCards[0].suffix}</small>}
                  </b>
                  {statCards[0].context && (
                    <span lang={statCards[0].contextLang}>{statCards[0].context}</span>
                  )}
                </div>
              </div>
            )}
            {program.cardImage && (
              <div class="pg-bento__photo">
                <ResponsiveImage
                  image={program.cardImage}
                  lang={lang}
                  aspect="4/3"
                  sizes="(min-width: 64rem) 45vw, 100vw"
                />
              </div>
            )}
            {statCards.slice(1).map((stat) => (
              <div class="pg-bento__stat">
                <span lang={stat.labelLang}>{stat.label}</span>
                <div>
                  {stat.percent !== null && (
                    <div class="pg-bento__bar" aria-hidden="true">
                      <i style={`width:${Math.min(stat.percent, 100)}%`} />
                    </div>
                  )}
                  {stat.prefix && <span lang={stat.prefixLang}>{stat.prefix}</span>}
                  <b>
                    {stat.value}
                    {stat.suffix && <small>{stat.suffix}</small>}
                  </b>
                  {stat.context && <span lang={stat.contextLang}>{stat.context}</span>}
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="pg-section pg-section--tint">
    <div class="pg-wrap">
      <SectionHead heading={tStrict(lang, 'programHowTitle')} />
      <ol class="pg-steps">
        {
          steps.map((step, index) => (
            <li class="pg-step">
              <span class="pg-step__num" aria-hidden="true">
                {index + 1}
              </span>
              <h3 class="pg-h3">{step.title}</h3>
              <p>{step.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <SectionedBody lang={lang} body={body} limits={ACTIVITY_LIMITS} />

  {
    story && (
      <section class="pg-section pg-section--tint">
        <div class="pg-wrap">
          <div class="pg-quote pg-quote--solo">
            <div>
              <span class="pg-kicker">{tStrict(lang, 'typeStory')}</span>
              {hasImpact ? (
                <div class="pg-quote__message">
                  <RichText blocks={impact} lang={lang} />
                </div>
              ) : (
                quote?.value && <blockquote lang={langAttr(quote)}>{quote.value}</blockquote>
              )}
              <cite>
                <b>{story.personName}</b>
                {storyRole?.value && <span lang={langAttr(storyRole)}> · {storyRole.value}</span>}
              </cite>
            </div>
          </div>
        </div>
      </section>
    )
  }

  {
    otherPrograms.length > 0 && (
      <section class="pg-section">
        <div class="pg-wrap">
          <SectionHead
            heading={tStrict(lang, 'otherPrograms')}
            more={{ label: tStrict(lang, 'viewAll'), href: localizePath('/programs', lang) }}
          />
          <div class="pg-grid pg-grid--3">
            {otherPrograms.map((entry) => {
              const card = programCard(entry, lang, tStrict(lang, 'learnMore'));
              return (
                <article class="pg-card">
                  <div class="pg-card__media">
                    {card.image && (
                      <ResponsiveImage
                        image={card.image}
                        lang={lang}
                        aspect="16/10"
                        sizes="(min-width: 64rem) 30vw, 100vw"
                      />
                    )}
                  </div>
                  <div class="pg-card__body">
                    <h3 class="pg-h3">
                      <a href={card.href}>{card.title}</a>
                    </h3>
                    <p lang={card.bodyLang}>{card.body}</p>
                    <a class="pg-link pg-card__link" href={card.href}>
                      {card.linkLabel} <span aria-hidden="true">→</span>
                    </a>
                  </div>
                </article>
              );
            })}
          </div>
        </div>
      </section>
    )
  }

  <BandCta heading={tStrict(lang, 'ctaProgramTitle')} actions={ctaActions(lang)} />

  {
    activitiesLink && (
      <section class="pg-section pg-section--tight">
        <div class="pg-wrap">
          <a href={localizePath('/activities', lang)} class="pg-link">
            {activitiesLink} <span aria-hidden="true">→</span>
          </a>
        </div>
      </section>
    )
  }
</BaseLayout>
