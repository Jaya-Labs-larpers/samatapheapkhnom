---
import { getStories, getStory } from '~/lib/content';
import type { Story as StoryDoc } from '~/lib/content/types';
import Story from '~/page-templates/sko/Story.astro';

export async function getStaticPaths() {
  const list = await getStories();
  const detailed = await Promise.all(list.map((entry) => getStory(entry.slug ?? entry._id)));
  return detailed
    .map((story) =>
      story ? { params: { slug: story.slug ?? story._id }, props: { story } } : null,
    )
    .filter((route): route is NonNullable<typeof route> => route !== null);
}

const { story } = Astro.props as { story: StoryDoc };
---

<Story lang="en" story={story} />
