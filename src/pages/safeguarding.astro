---
import { getReports } from '~/lib/content';
import { tStrict } from '~/lib/skeleton-content';
import Policy from '~/page-templates/sko/Policy.astro';
import ReportList from '~/components/content/ReportList.astro';

const lang = 'en' as const;
const policies = (await getReports()).filter((report) => report.type === 'policy');
---

<Policy lang={lang} slug="safeguarding" fallbackTitleKey="pageSafeguarding">
  {
    policies.length > 0 && (
      <>
        <h2 class="sk-h2">{tStrict(lang, 'navSafeguarding')}</h2>
        <ReportList lang={lang} reports={policies} />
      </>
    )
  }
</Policy>
