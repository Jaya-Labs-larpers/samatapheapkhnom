---
import '~/styles/global.css';

import { htmlLang, type Locale } from '~/lib/i18n/config';
import { t } from '~/lib/i18n/utils';
import { getSiteSettings } from '~/lib/content';
import { cfAnalyticsToken, gtmId, hasSanity, smoothScrollEnabled } from '~/lib/config';
import type { CmsImage } from '~/lib/content/types';
import Header from '~/components/layout/Header.astro';
import Footer from '~/components/layout/Footer.astro';
import MinimalHeader from '~/components/layout/MinimalHeader.astro';
import SeoHead from '~/components/seo/SeoHead.astro';

interface Props {
  lang: Locale;
  title: string;
  description?: string;
  ogImage?: CmsImage | null;
  noindex?: boolean;
  plainTitle?: boolean;
  publishedAt?: string | null;
  /** Extra schema.org node for this page type, e.g. Article or BreadcrumbList. */
  jsonLd?: Record<string, unknown> | null;
  /** Extra properties for the Organization node. */
  orgJsonLd?: Record<string, unknown> | null;
  /** A focused page (Donate): slim header, no footer, no third-party scripts. */
  minimal?: boolean;
}

const {
  lang,
  title,
  description,
  ogImage,
  noindex,
  plainTitle,
  publishedAt,
  jsonLd,
  orgJsonLd,
  minimal = false,
} = Astro.props;

const settings = await getSiteSettings();
const pathname = Astro.url.pathname;
/*
  GTM waits for the page's own load and then for an idle moment, so its download
  and parse never compete with the first paint. Page views are still counted:
  GTM fires its own page-view from the dataLayer once it starts. A prerendered
  page waits until the visitor actually opens it, so unvisited prerenders never
  count as views.
*/
const gtmLoader =
  gtmId && !minimal
    ? `(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','${gtmId}');`
    : '';
const gtmSnippet =
  gtmLoader &&
  `(function(){var go=function(){${gtmLoader}};var idle=function(){(window.requestIdleCallback||function(f){setTimeout(f,1)})(go,{timeout:4000})};var start=function(){if(document.readyState==='complete')idle();else addEventListener('load',idle)};if(document.prerendering)document.addEventListener('prerenderingchange',start,{once:true});else start();})();`;
const beaconLoader =
  cfAnalyticsToken && !minimal
    ? `(function(){var go=function(){var s=document.createElement('script');s.defer=true;s.src='https://static.cloudflareinsights.com/beacon.min.js';s.setAttribute('data-cf-beacon',${JSON.stringify(JSON.stringify({ token: cfAnalyticsToken }))});document.head.appendChild(s)};if(document.prerendering)document.addEventListener('prerenderingchange',go,{once:true});else go();})();`
    : '';
const speculationRules = JSON.stringify({
  prerender: [
    {
      where: {
        and: [
          { href_matches: '/*' },
          { not: { href_matches: ['/api/*', '/*.*'] } },
          { not: { selector_matches: '[download], [target=_blank], [rel~=nofollow]' } },
        ],
      },
      eagerness: 'moderate',
    },
  ],
});
const preloadFonts =
  lang === 'km'
    ? ['noto-sans-khmer', 'noto-sans-latin', 'source-serif-4-latin']
    : ['noto-sans-latin', 'source-serif-4-latin'];
---

<!doctype html>
<html lang={htmlLang[lang]} data-smooth-scroll={smoothScrollEnabled ? 'on' : undefined}>
  <head>
    <meta charset="utf-8" />
    {
      /*
      Replaced at build time by scripts/csp.mjs with this page's own policy,
      including SHA-256 hashes for its inline structured-data scripts. Must come
      before anything it governs. `frame-ancestors` lives in public/_headers
      because a meta-delivered policy cannot set it.
    */
    }
    <meta http-equiv="Content-Security-Policy" content="__CSP_POLICY__" />
    {gtmSnippet && <script is:inline set:html={gtmSnippet} />}
    {beaconLoader && <script is:inline set:html={beaconLoader} />}
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#F5F7FD" />

    {
      /*
      Preload what the first paint needs, and no more: the locale's body font and
      its Latin face on Khmer pages. The other script
      still loads — the language toggle renders "ខ្មែរ" on English pages — but
      lazily, under font-display: swap, so it never blocks LCP for one word of
      chrome.
    */
    }
    {
      preloadFonts.map((font) => (
        <link
          rel="preload"
          as="font"
          type="font/woff2"
          crossorigin="anonymous"
          href={`/fonts/${font}.woff2`}
        />
      ))
    }
    {hasSanity && <link rel="preconnect" href="https://cdn.sanity.io" />}
    <link rel="preload" as="image" type="image/svg+xml" href="/logo/sko-logo-full-colour.svg" />
    {
      /*
      Prerenders a same-site page once the visitor shows intent (hover on
      desktop, touch start on phones), so the click swaps to a finished page.
      Files, the API and links that open elsewhere are left out.
    */
    }
    <script is:inline type="speculationrules" set:html={speculationRules} />
    <SeoHead
      lang={lang}
      pathname={pathname}
      title={title}
      description={description}
      ogImage={ogImage}
      noindex={noindex}
      plainTitle={plainTitle}
      settings={settings}
      publishedAt={publishedAt}
      jsonLd={jsonLd}
      orgJsonLd={orgJsonLd}
    />

  </head>
  <body class="bg-white">
    {
      gtmId && !minimal && (
        <noscript>
          <iframe
            src={`https://www.googletagmanager.com/ns.html?id=${gtmId}`}
            height="0"
            width="0"
            style="display:none;visibility:hidden"
          />
        </noscript>
      )
    }
    <a
      href="#main"
      class="sr-only-focusable absolute top-3 left-3 z-[100] rounded-[var(--radius-md)] bg-[color:var(--color-blue-700)] px-4 py-3 text-[15px] font-semibold text-white no-underline"
    >
      {t(lang, 'skipToContent')}
    </a>

    {
      minimal ? (
        <MinimalHeader lang={lang} pathname={pathname} settings={settings} />
      ) : (
        <Header lang={lang} pathname={pathname} settings={settings} />
      )
    }

    <main id="main" tabindex="-1">
      <slot />
    </main>

    {!minimal && <Footer lang={lang} settings={settings} pathname={pathname} />}

    <script>
      import { revealOnEntry } from '~/lib/reveal';
      import { initScrollMotion } from '~/lib/scroll-motion';

      revealOnEntry();
      initScrollMotion();
    </script>
  </body>
</html>
