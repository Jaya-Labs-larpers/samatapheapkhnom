---
import '~/styles/global.css';

import { htmlLang, type Locale } from '~/lib/i18n/config';
import { parsePath, t } from '~/lib/i18n/utils';
import { getSiteSettings } from '~/lib/content';
import { cfAnalyticsToken, hasSanity, smoothScrollEnabled } from '~/lib/config';
import type { CmsImage } from '~/lib/content/types';
import Header from '~/components/layout/Header.astro';
import Footer from '~/components/layout/Footer.astro';
import MinimalHeader from '~/components/layout/MinimalHeader.astro';
import SeoHead from '~/components/seo/SeoHead.astro';

interface Props {
  lang: Locale;
  title: string;
  description?: string;
  ogImage?: CmsImage | null;
  noindex?: boolean;
  plainTitle?: boolean;
  publishedAt?: string | null;
  jsonLd?: Record<string, unknown> | null;
  orgJsonLd?: Record<string, unknown> | null;
  minimal?: boolean;
  noFooter?: boolean;
  darkHero?: boolean;
  serifAboveFold?: boolean;
}

const {
  lang,
  title,
  description,
  ogImage,
  noindex,
  plainTitle,
  publishedAt,
  jsonLd,
  orgJsonLd,
  minimal = false,
  noFooter = false,
  darkHero = false,
  serifAboveFold = true,
} = Astro.props;

const settings = await getSiteSettings();
const pathname = Astro.url.pathname;
const defaultHome = lang === 'en' && parsePath(pathname).path === '/';
// Runs before first paint, but not while prerendering: the cookie may change before the click.
const homeRedirect = `(() => {
  const go = () => {
    if (/(?:^|; )sko-lang=km(?:;|$)/.test(document.cookie))
      location.replace('/km/' + location.search + location.hash);
  };
  if (document.prerendering) document.addEventListener('prerenderingchange', go, { once: true });
  else go();
})();`;
const speculationRules = JSON.stringify({
  prerender: [
    {
      where: {
        and: [
          { href_matches: '/*' },
          { not: { href_matches: ['/api/*', '/*.*'] } },
          { not: { selector_matches: '[download], [target=_blank], [rel~=nofollow]' } },
        ],
      },
      eagerness: 'moderate',
    },
  ],
  prefetch: [
    {
      where: {
        and: [{ href_matches: '/*' }, { not: { href_matches: '/api/*' } }],
      },
      eagerness: 'conservative',
    },
  ],
});
const baseFonts =
  lang === 'km'
    ? ['noto-sans-khmer', 'noto-sans-latin']
    : ['noto-sans-latin'];
const preloadFonts = serifAboveFold ? [...baseFonts, 'source-serif-4-latin'] : baseFonts;
const preloadLogo =
  darkHero && !minimal ? '/logo/sko-logo-reversed.svg' : '/logo/sko-logo-full-colour.svg';
---

<!doctype html>
<html
  lang={htmlLang[lang]}
  translate="no"
  data-smooth-scroll={smoothScrollEnabled ? 'on' : undefined}
>
  <head>
    <meta charset="utf-8" />
    {
      /*
      Replaced at build time by scripts/csp.mjs with this page's own policy,
      including SHA-256 hashes for its inline structured-data scripts. Must come
      before anything it governs. `frame-ancestors` lives in public/_headers
      because a meta-delivered policy cannot set it.
    */
    }
    {import.meta.env.PROD && <meta http-equiv="Content-Security-Policy" content="__CSP_POLICY__" />}
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    {defaultHome && <script is:inline set:html={homeRedirect} />}
    <meta name="generator" content={Astro.generator} />
    <meta name="google" content="notranslate" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#F5F7FD" />

    {
      preloadFonts.map((font) => (
        <link
          rel="preload"
          as="font"
          type="font/woff2"
          crossorigin="anonymous"
          href={`/fonts/${font}.woff2`}
        />
      ))
    }
    {hasSanity && <link rel="dns-prefetch" href="https://cdn.sanity.io" />}
    <link rel="preload" as="image" type="image/svg+xml" href={preloadLogo} fetchpriority="low" />
    <script is:inline type="speculationrules" set:html={speculationRules} />
    <SeoHead
      lang={lang}
      pathname={pathname}
      title={title}
      description={description}
      ogImage={ogImage}
      noindex={noindex}
      plainTitle={plainTitle}
      settings={settings}
      publishedAt={publishedAt}
      jsonLd={jsonLd}
      orgJsonLd={orgJsonLd}
    />
  </head>
  <body data-cf-token={(!minimal && cfAnalyticsToken) || undefined}>
    <a
      href="#main"
      class="sr-only-focusable absolute top-3 left-3 z-[100] rounded-[var(--radius-md)] bg-[color:var(--color-blue-700)] px-4 py-3 text-[15px] font-semibold text-white no-underline"
    >
      {t(lang, 'skipToContent')}
    </a>

    {
      minimal ? (
        <MinimalHeader lang={lang} pathname={pathname} settings={settings} />
      ) : (
        <Header lang={lang} pathname={pathname} settings={settings} darkHero={darkHero} />
      )
    }

    <main id="main" tabindex="-1">
      <slot />
    </main>

    {!minimal && !noFooter && <Footer lang={lang} settings={settings} pathname={pathname} />}

    <script>
      import { revealOnEntry } from '~/lib/reveal';
      import { initScrollMotion } from '~/lib/scroll-motion';
      import { onPageLoad } from '~/lib/page-load';
      import { hydrateDeferredImages, revealWhenLoaded, whenSettled } from '~/lib/lazy';

      onPageLoad((signal) => {
        revealWhenLoaded();
        hydrateDeferredImages();
        requestAnimationFrame(() =>
          requestAnimationFrame(() => {
            if (signal.aborted) return;
            revealOnEntry();
            initScrollMotion(signal);
          }),
        );
      });

      if (!HTMLScriptElement.supports?.('speculationrules')) {
        const prefetched = new Set<string>();
        const canPrefetch = () => {
          const connection = (
            navigator as Navigator & { connection?: { saveData?: boolean; effectiveType?: string } }
          ).connection;
          if (connection?.saveData) return false;
          return !connection?.effectiveType || !/^(slow-)?2g$/.test(connection.effectiveType);
        };
        const onIntent = (event: Event) => {
          if (!canPrefetch()) return;
          const anchor = (event.target as Element | null)?.closest?.<HTMLAnchorElement>('a[href]');
          if (!anchor || anchor.target || anchor.hasAttribute('download')) return;
          if (anchor.origin !== location.origin || anchor.pathname === location.pathname) return;
          if (anchor.pathname.startsWith('/api/') || prefetched.has(anchor.href)) return;
          prefetched.add(anchor.href);
          const link = document.createElement('link');
          link.rel = 'prefetch';
          link.as = 'document';
          link.href = anchor.href;
          document.head.append(link);
        };
        document.addEventListener('pointerenter', onIntent, { capture: true, passive: true });
        document.addEventListener('touchstart', onIntent, { passive: true });
        document.addEventListener('focusin', onIntent, { passive: true });
      }

      const token = document.body.dataset.cfToken;
      if (token) {
        const loadBeacon = () =>
          whenSettled(() => {
            const script = document.createElement('script');
            script.src = 'https://static.cloudflareinsights.com/beacon.min.js';
            script.dataset.cfBeacon = JSON.stringify({ token });
            document.head.append(script);
          });
        if ('prerendering' in document && document.prerendering)
          document.addEventListener('prerenderingchange', loadBeacon, { once: true });
        else loadBeacon();
      }
    </script>
  </body>
</html>
